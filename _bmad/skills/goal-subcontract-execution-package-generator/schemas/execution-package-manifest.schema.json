{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-package-manifest.schema.json",
  "title": "Goal Subcontract Execution Package Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "packageManifestHash",
    "repositoryRoot",
    "repositoryBaseline",
    "goalContract",
    "partitionManifest",
    "evidenceSchema",
    "closureSchema",
    "requirementRecordBinding",
    "children",
    "artifacts",
    "collectionVerificationCommands"
  ],
  "properties": {
    "schemaVersion": {
      "const": "goal-subcontract-execution-package/v2"
    },
    "packageId": {
      "type": "string",
      "pattern": "^goal-subcontract-package-[a-f0-9]{16}$"
    },
    "packageManifestHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "repositoryRoot": {
      "type": "string",
      "minLength": 1
    },
    "repositoryBaseline": {
      "type": "object",
      "required": ["headCommit", "treeHash"],
      "properties": {
        "headCommit": { "$ref": "#/$defs/gitHash" },
        "treeHash": { "$ref": "#/$defs/gitHash" }
      },
      "additionalProperties": false
    },
    "authorityProfile": {
      "enum": ["standalone_frozen", "main_agent_compiled"]
    },
    "certification": { "$ref": "#/$defs/sourceBinding" },
    "goalContractBundle": { "$ref": "#/$defs/sourceBinding" },
    "partitionCoverageReceipt": { "$ref": "#/$defs/sourceBinding" },
    "currentDispatchPointer": { "$ref": "#/$defs/sourceBinding" },
    "transactionManifest": { "$ref": "#/$defs/sourceBinding" },
    "goalContract": { "$ref": "#/$defs/sourceBinding" },
    "partitionManifest": { "$ref": "#/$defs/partitionManifestBinding" },
    "evidenceSchema": { "$ref": "#/$defs/sourceBinding" },
    "closureSchema": { "$ref": "#/$defs/sourceBinding" },
    "requirementRecordBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "recordId", "requirementSetId", "recordPathHash"],
          "properties": {
            "status": { "const": "present" },
            "recordId": { "type": "string", "minLength": 1 },
            "requirementSetId": { "type": "string", "minLength": 1 },
            "recordPathHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "downstreamAction"],
          "properties": {
            "status": { "const": "absent" },
            "downstreamAction": {
              "const": "main_agent_resolve_requirement_record"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "partitionId",
          "displayTitle",
          "ordinal",
          "contract",
          "predecessorPartitionIds",
          "ownedArtifactPaths",
          "requiredCommandIds",
          "packetPath",
          "packetHash",
          "promptPath",
          "promptHash"
        ],
        "properties": {
          "partitionId": { "$ref": "#/$defs/nonEmptyString" },
          "displayTitle": { "$ref": "#/$defs/nonEmptyString" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "contract": { "$ref": "#/$defs/sourceBinding" },
          "predecessorPartitionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonEmptyString" }
          },
          "ownedArtifactPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonEmptyString" }
          },
          "requiredCommandIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonEmptyString" }
          },
          "packetPath": { "$ref": "#/$defs/nonEmptyString" },
          "packetHash": { "$ref": "#/$defs/sha256" },
          "promptPath": { "$ref": "#/$defs/nonEmptyString" },
          "promptHash": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "hash"],
        "properties": {
          "kind": {
            "enum": [
              "child-packet",
              "child-prompt",
              "campaign-prompt",
              "task-report-template",
              "handoff-template"
            ]
          },
          "path": { "$ref": "#/$defs/nonEmptyString" },
          "hash": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "collectionVerificationCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "command": { "$ref": "#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["authorityProfile"],
        "properties": { "authorityProfile": { "const": "main_agent_compiled" } }
      },
      "then": {
        "required": ["certification", "goalContractBundle", "partitionCoverageReceipt", "currentDispatchPointer", "transactionManifest"],
        "properties": {
          "requirementRecordBinding": { "properties": { "status": { "const": "present" } } }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitHash": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "sourceBinding": {
      "type": "object",
      "required": ["path", "hash"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "partitionManifestBinding": {
      "type": "object",
      "required": ["path", "hash", "partitionManifestHash"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "hash": { "$ref": "#/$defs/sha256" },
        "partitionManifestHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goal-campaign-closure-receipt.schema.json",
  "title": "Goal Campaign Closure Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "closeoutAttemptId",
    "priorAttemptHash",
    "contextHash",
    "compileReceiptHash",
    "childClosureSetHash",
    "campaignReportPath",
    "campaignReportHash",
    "taskReportCandidatePath",
    "taskReportArtifactHash",
    "status",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": "goal-campaign-closure-receipt/v1" },
    "closeoutAttemptId": { "type": "string", "minLength": 1 },
    "priorAttemptHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "contextHash": { "$ref": "#/$defs/sha256" },
    "compileReceiptHash": { "$ref": "#/$defs/sha256" },
    "childClosureSetHash": { "$ref": "#/$defs/sha256" },
    "campaignReportPath": { "const": "campaign-report.json" },
    "campaignReportHash": { "$ref": "#/$defs/sha256" },
    "taskReportCandidatePath": { "const": "task-report-candidate.json" },
    "taskReportArtifactHash": { "$ref": "#/$defs/sha256" },
    "status": { "const": "campaign_closed" },
    "receiptHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}

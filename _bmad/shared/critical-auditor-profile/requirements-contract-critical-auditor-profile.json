  "dimensionContractBinding": {
    "dimensionSetId": "requirements-contract-critical-auditor-dimensions/v1",
    "dimensions": [
      "requirement_coverage_completeness",
      "controlled_must_atomicity",
      "target_authority_correctness",
      "validation_command_authority",
      "behavior_edge_failure_path_coverage",
      "packet_source_reconciliation",
      "no_fallback_no_synthetic_receipt",
      "hash_binding",
      "current_id_namespace",
      "source_materialization_safety",
      "user_confirmability_gate"
    ],
    "sourceDocumentCoverageRequired": true,
    "consumerTargetProjectionRequired": true,
    "businessCoverageSanityRequired": true
  },
  "checkItemSetBinding": {
    "requiredCheckItemPrefix": "requirements_contract.",
    "eachDimensionRequiresCheckItem": true,
    "vetoItemsMustPass": true,
    "gateDryRunBlockersMustBeDisposed": true
  },
  "auditRoundPolicy": {
    "consecutiveNoGapRoundsRequired": 3,
    "resetOnHashChange": [
      "requestHash",
      "sourceHash",
      "sourceDocumentHash",
      "implementationConfirmationHash",
      "packetHash",
      "gateDryRunHash",
      "transactionId",
      "namespaceVersion"
    ],
    "staleConvergenceForbidden": true,
    "syntheticCleanReceiptsForbidden": true
  },
  "roundReceiptContract": {
    "requiredFields": [
      "schemaVersion",
      "requestHash",
      "recordId",
      "roundIndex",
      "transactionId",
      "namespaceVersion",
      "sourceHash",
      "sourceDocumentHash",
      "implementationConfirmationHash",
      "packetHash",
      "gateDryRunHash",
      "reconciliationIssueCount",
      "checkedProjectionGroups",
      "verdict",
      "reviewedMustRefs",
      "reviewedProjectionRefs",
      "priorFindingsDisposition",
      "falsePositiveProofs",
      "gapCandidates",
      "validatedGaps",
      "rejectedGapCandidates",
      "rationale"
    ]
  },
  "convergenceReceiptContract": {
    "requiredConsecutiveRoundReceipts": 3,
    "allowedWriter": "main_session_only",
    "noNewGapVerdicts": [
      "no_new_valid_gap",
      "no_new_confirmation_blocking_gap"
    ],
    "hashBindingMustBeIdenticalAcrossRounds": true,
    "sourcePromotionRequiresGatePass": true,
    "sourcePromotionRequiresPacketSourceReconciliation": true
  },
  "failClosedPolicy": {
    "blockingReasons": [
      "critical_auditor_round_provider_missing",
      "critical_auditor_response_missing",
      "critical_auditor_response_hash_mismatch",
      "critical_auditor_response_namespace_mismatch",
      "critical_auditor_valid_gap_found",
      "source_materialization_before_convergence",
      "source_hash_race_detected",
      "synthetic_clean_receipt_forbidden"
    ],
    "sourceMutationBeforeConvergenceAllowed": false,
    "sourceMaterializationReceiptBeforePromotionAllowed": false
  },
  "auditCallPointRegistry": {
    "author-confirmation-ready-source": "requirements_compiler",
    "critical_auditor_round": "requirements_compiler",
    "critical_auditor_rework": "post_implementation_code_audit",
    "source_promotion": "delivery_confirmation"
  },
  "triadOrchestrationPolicy": {
    "perspectivesRequiredPerRound": [
      "product_intent",
      "model_projection",
      "main_agent_execution"
    ],
    "mainSessionInlineDefault": true,
    "mainAgentOwnsRepair": true,
    "subagentsMayWriteRuntimeState": false
  },
  "subagentIndependencePolicy": {
    "readonlyResponseProviderOnly": true,
    "subagentsMayWriteSource": false,
    "subagentsMayWritePacket": false,
    "subagentsMayWriteReceipt": false,
    "subagentsMayWriteRequirementRecord": false,
    "subagentsMayDeclareConvergence": false
  },
  "mainAgentRepairPolicy": {
    "repairOwner": "main_session",
    "repairTarget": "authoring/staging/draft-source.md",
    "sourceAuthorityWriteRequiresConvergence": true,
    "repairMustPrecedeNextAuditRound": true
  },
  "repairReceiptFeedbackPolicy": {
    "feedbackDispatchRequired": true,
    "nextRoundMustConsumePreviousReceipt": true,
    "stagingDraftHashMustChangeWhenValidatedGapRequiresRework": true
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "masterSourceHash",
    "sourceSnapshotHash",
    "methodologyProfileHash",
    "executionProjectionHash",
    "partitionManifestHash",
    "partitionIds",
    "unmappedSourceObligations",
    "duplicatePrimarySourceObligations",
    "unmappedTraceSlices",
    "duplicatePrimaryTraceSlices",
    "unmappedAtomicTasks",
    "duplicatePrimaryAtomicTasks",
    "unresolvedDependencies",
    "unownedSharedArtifacts",
    "finalIntegrationPartitionIds",
    "decision",
    "blockingReasons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "goal-contract-partition-global-coverage-receipt/v1"
    },
    "masterSourceHash": { "$ref": "#/$defs/hash" },
    "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
    "methodologyProfileHash": { "$ref": "#/$defs/hash" },
    "executionProjectionHash": { "$ref": "#/$defs/hash" },
    "partitionManifestHash": { "$ref": "#/$defs/hash" },
    "partitionIds": { "$ref": "#/$defs/partitionIds" },
    "unmappedSourceObligations": { "$ref": "#/$defs/ids" },
    "duplicatePrimarySourceObligations": { "$ref": "#/$defs/ids" },
    "unmappedTraceSlices": { "$ref": "#/$defs/ids" },
    "duplicatePrimaryTraceSlices": { "$ref": "#/$defs/ids" },
    "unmappedAtomicTasks": { "$ref": "#/$defs/ids" },
    "duplicatePrimaryAtomicTasks": { "$ref": "#/$defs/ids" },
    "unresolvedDependencies": { "$ref": "#/$defs/ids" },
    "unownedSharedArtifacts": { "$ref": "#/$defs/ids" },
    "finalIntegrationPartitionIds": { "$ref": "#/$defs/partitionIds" },
    "decision": { "enum": ["pass", "blocked"] },
    "blockingReasons": { "$ref": "#/$defs/ids" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "pass" } } },
      "then": { "properties": { "blockingReasons": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "decision": { "const": "blocked" } } },
      "then": { "properties": { "blockingReasons": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "partitionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^partition-[0-9a-f]{64}$"
      }
    }
  }
}

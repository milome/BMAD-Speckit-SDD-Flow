{
  "schemaVersion": "partition-methodology-profile/v1",
  "profileId": "goal-contract-partition-default",
  "profileVersion": "1.0.0",
  "canonicalizationVersion": "stable-json/path-sorted-rules/v1",
  "rules": [
    {
      "ruleId": "PM-001",
      "classification": "adopted",
      "normativeRule": "Group requirements by user-observable outcome or coherent system capability rather than by directory, package, language or technical layer.",
      "deterministicChecks": ["epic_grouping_not_technical_layer"]
    },
    {
      "ruleId": "PM-002",
      "classification": "adopted",
      "normativeRule": "Preserve complete requirement coverage through an explicit machine-verifiable coverage map.",
      "deterministicChecks": ["exact_primary_source_coverage"]
    },
    {
      "ruleId": "PM-003",
      "classification": "adapted",
      "normativeRule": "Prefer independently closeable vertical Trace Slices that bind implementation, acceptance, applicable negative controls and evidence.",
      "deterministicChecks": ["trace_slice_vertical_closure"]
    },
    {
      "ruleId": "PM-004",
      "classification": "adopted",
      "normativeRule": "An execution unit may depend only on frozen inputs and completed predecessor outputs.",
      "deterministicChecks": ["no_future_dependency"]
    },
    {
      "ruleId": "PM-005",
      "classification": "adopted",
      "normativeRule": "Every Atomic Task is bounded for one implementation agent with an explicit write scope and verification command set.",
      "deterministicChecks": ["atomic_task_agent_bounded"]
    },
    {
      "ruleId": "PM-006",
      "classification": "adapted",
      "normativeRule": "Validate dependency direction, complete coverage, acceptance quality and applicable failure paths before release.",
      "deterministicChecks": ["dependency_direction_valid", "acceptance_evidence_complete"]
    },
    {
      "ruleId": "PM-007",
      "classification": "project-extension",
      "normativeRule": "Bind Completion Predicates, Evidence Contracts, independent oracles, freshness and replay rules to each Trace Slice.",
      "deterministicChecks": ["evidence_contract_complete"]
    },
    {
      "ruleId": "PM-008",
      "classification": "project-extension",
      "normativeRule": "Preserve one typed task universe, deterministic hash binding and fail-closed reconciliation.",
      "deterministicChecks": ["single_task_universe", "fail_closed_reconciliation"]
    }
  ],
  "exclusions": [
    "interactive_bmad_workflow",
    "intermediate_epics_markdown",
    "interactive_menu_state",
    "bmad_story_runtime_state",
    "fixed_epic_story_markdown_template",
    "prd_architecture_ux_only_input_assumption"
  ],

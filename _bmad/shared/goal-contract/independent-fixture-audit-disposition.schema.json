{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/independent-fixture-audit-disposition.schema.json",
  "title": "IndependentFixtureAuditDisposition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewEpoch",
    "artifactSetHash",
    "actorRole",
    "decision",
    "blockerCount",
    "importantFindingCount",
    "reports",
    "disposedAt",
    "basis",
    "dispositionHash"
  ],
  "properties": {
    "schemaVersion": { "const": "IndependentFixtureAuditDisposition/v1" },
    "reviewEpoch": { "type": "string", "minLength": 1 },
    "artifactSetHash": { "$ref": "#/$defs/sha256" },
    "actorRole": { "const": "main_session" },
    "decision": { "const": "confirm_fixture_review" },
    "blockerCount": { "const": 0 },
    "importantFindingCount": { "const": 0 },
    "reports": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["perspective", "path", "bytes", "sha256"],
        "properties": {
          "perspective": {
            "enum": ["source_coverage", "semantic_mapping", "executable_verification"]
          },
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "disposedAt": { "type": "string", "minLength": 1 },
    "basis": { "type": "string", "minLength": 1 },
    "dispositionHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/canonical-requirement-graph.schema.json",
  "title": "CanonicalRequirementGraph/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourcePlanId", "sourcePlanVersion", "goal", "scope", "nonGoals", "nodes", "relations", "aliases", "graphHash"],
  "properties": {
    "schemaVersion": { "const": "CanonicalRequirementGraph/v1" },
    "sourcePlanId": { "type": "string", "minLength": 1 },
    "sourcePlanVersion": { "const": "standalone-source-plan/v1" },
    "goal": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/strings" },
    "nonGoals": { "$ref": "#/$defs/strings" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
    "graphHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "kind": { "enum": ["REQ", "NFR", "NEG", "OUT", "TASK", "AC", "PATH", "CMD", "EVD", "ART", "DEP", "STOP"] },
    "applicability": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["always", "conditional"] }, "condition": { "type": "string", "minLength": 1 } } },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "statement", "normativeStrength", "polarity", "applicability", "scope", "aliases", "ownerRef", "references", "attributes", "sourceSpanRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "normativeStrength": { "enum": ["MUST", "SHOULD", "MAY"] },
        "polarity": { "enum": ["required", "forbidden", "excluded", "permitted", "descriptive"] },
        "applicability": { "$ref": "#/$defs/applicability" },
        "scope": { "enum": ["local", "global"] },
        "aliases": { "$ref": "#/$defs/strings" },
        "ownerRef": { "type": ["string", "null"] },
        "references": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } },
        "attributes": { "type": "object" },
        "sourceSpanRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^SPAN-[0-9A-F]{16}$" } }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "fromRef", "toRef", "scope", "sourceSpanRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^REL-[0-9A-F]{16}$" },
        "type": { "enum": ["owned_by", "applies_to_requirement", "implemented_by", "accepted_by", "uses_path", "validated_by", "evidenced_by", "produces_artifact", "depends_on", "guarded_by", "produced_by", "consumed_by", "includes_command", "globally_authorized_by"] },
        "fromRef": { "type": "string", "minLength": 1 },
        "toRef": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["local", "global"] },
        "sourceSpanRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "canonicalRef", "sourceSpanRefs"],
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "canonicalRef": { "type": "string", "minLength": 1 },
        "sourceSpanRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}

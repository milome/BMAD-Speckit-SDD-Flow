{
  "schemaVersion": "goal-contract-partition-impact-policy/v1",
  "analyzerId": "bmad-speckit-partition-impact-analyzer",
  "analyzerVersion": "1.0.0",
  "allowedRoots": [
    "."
  ],
  "analyzedExtensions": [
    ".cjs",
    ".cts",
    ".js",
    ".json",
    ".jsx",
    ".mjs",
    ".mts",
    ".ts",
    ".tsx",
    ".yaml",
    ".yml"
  ],
  "hashOnlyTextExtensions": [
    ".bat",
    ".cmd",
    ".css",
    ".html",
    ".md",
    ".ps1",
    ".scss",
    ".sh",
    ".svelte",
    ".toml",
    ".txt",
    ".vue"
  ],
  "excludedPathPrefixes": [
    ".artifacts/",
    ".cache/",
    ".claude/",
    ".codex/",
    ".codex-tmp/",
    ".cursor/",
    ".git/",
    ".tmp/",
    ".turbo/",
    ".worktrees/",
    "Devclaw-scope/",
    "_bmad-output/",
    "coverage/",
    "dist/",
    "docs/plans/",
    "node_modules/",
    "outputs/",
    "partition-runs/",
    "playwright-report/",
    "test-results/"
  ],
  "binaryExtensions": [
    ".7z",
    ".bin",
    ".db",
    ".dll",
    ".exe",
    ".gif",
    ".gz",
    ".iso",
    ".jpeg",
    ".jpg",
    ".map",
    ".pdf",
    ".pdb",
    ".png",
    ".rar",
    ".sqlite",
    ".tar",
    ".tgz",
    ".webp",
    ".zip"
  ],
  "maxCandidateFiles": 20000,
  "maxVisitedDirectories": 5000,
  "maxBytesPerFile": 1048576,
  "maxAggregateBytes": 268435456,
  "maxResolvedEdges": 250000,
  "maxConflictChainsPerPartition": 20,
  "maxDiagnosticRecords": 20,
  "maxCliOutputBytes": 32768,
  "supportedRelationKinds": [
    "canonical_asset_path",
    "command_artifact",
    "commonjs_require",
    "dynamic_import_literal",
    "filesystem_literal",
    "generated_surface",
    "json_manifest_path",
    "json_schema_ref",
    "static_export",
    "static_import",
    "tsconfig_path"
  ],
  "unsupportedSyntaxDecision": "blocked"
}

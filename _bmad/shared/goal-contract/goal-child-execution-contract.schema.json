{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/goal-child-execution-contract.schema.json",
  "title": "Goal Child Execution Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "childContractId", "partitionId", "profile", "goalId", "goalExecutionIRHash", "partitionMembershipHash", "componentRefs", "taskRefs", "traceSliceRefs", "obligationRefs", "dependencyPartitionRefs", "expectedEffortMinutes", "upperBoundEffortMinutes", "logicalScopes", "obligations", "logicalSpecSpans", "executionDomains", "traceSlices", "atomicTasks", "dependencies", "commands", "evidenceContracts", "artifacts", "coExecutionConstraints", "childContractHash"],
  "properties": {
    "schemaVersion": { "const": "GoalChildExecutionContract/v1" },
    "childContractId": { "type": "string", "pattern": "^CHILD-[A-F0-9]{16}$" },
    "partitionId": { "type": "string", "pattern": "^PART-[0-9]{3}$" },
    "profile": { "enum": ["requirements_backed", "standalone"] },
    "goalId": { "type": "string", "minLength": 1 },
    "goalExecutionIRHash": { "$ref": "#/$defs/hash" },
    "partitionMembershipHash": { "$ref": "#/$defs/hash" },
    "componentRefs": { "$ref": "#/$defs/strings" },
    "taskRefs": { "$ref": "#/$defs/strings" },
    "traceSliceRefs": { "$ref": "#/$defs/strings" },
    "obligationRefs": { "$ref": "#/$defs/strings" },
    "dependencyPartitionRefs": { "$ref": "#/$defs/stringsAllowEmpty" },
    "expectedEffortMinutes": { "type": "integer", "minimum": 1 },
    "upperBoundEffortMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
    "logicalScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownedPaths", "forbiddenPaths"],
      "properties": {
        "ownedPaths": { "$ref": "#/$defs/stringsAllowEmpty" },
        "forbiddenPaths": { "$ref": "#/$defs/stringsAllowEmpty" }
      }
    },
    "obligations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "logicalSpecSpans": { "type": "array", "items": { "type": "object" } },
    "executionDomains": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "traceSlices": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "atomicTasks": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "commands": { "type": "array", "items": { "type": "object" } },
    "evidenceContracts": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "coExecutionConstraints": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "childContractHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stringsAllowEmpty": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}

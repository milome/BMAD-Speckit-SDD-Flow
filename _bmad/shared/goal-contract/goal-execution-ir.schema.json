{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/goal-execution-ir.schema.json",
  "title": "Goal Execution IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "goalId", "semanticSource", "technicalAuthority", "obligations", "aliases", "logicalSpecSpans", "executionDomains", "traceSlices", "atomicTasks", "dependencies", "logicalScopes", "commands", "evidenceContracts", "artifacts", "coExecutionConstraints", "goalExecutionIRHash"],
  "properties": {
    "schemaVersion": { "enum": ["GoalExecutionIR/v1", "GoalExecutionIR/v2", "GoalExecutionIR/v3"] },
    "profile": { "enum": ["requirements_backed", "standalone"] },
    "goalId": { "type": "string", "pattern": "^GOAL-[A-F0-9]{16}$" },
    "semanticSource": { "type": "object", "properties": {
      "canonicalRequirementGraphRef": { "$ref": "#/$defs/canonicalRequirementGraphRef" }
    } },
    "requirementsLineage": { "type": "object" },
    "standaloneLineage": {
      "type": "object",
      "required": ["internalSemanticGateHash"],
      "properties": {
        "internalSemanticGateHash": { "$ref": "#/$defs/hash" }
      }
    },
    "sourceLineage": { "$ref": "#/$defs/sourceLineage" },
    "technicalAuthority": { "type": "object" },
    "obligations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "aliases": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "logicalSpecSpans": { "type": "array", "items": { "type": "object" } },
    "executionDomains": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["executionDomainId", "isolationMode", "ownership", "commandRefs", "logicalTargetPaths", "basisRefs"] } },
    "traceSlices": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["traceSliceId", "executionDomainRef", "obligationRefs", "taskRefs", "commandRefs", "evidenceContractRefs", "basisRefs"] } },
    "atomicTasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "logicalScopes": { "type": "object", "required": ["ownedPaths", "forbiddenPaths"] },
    "commands": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["commandId", "invocation", "obligationRefs", "atomRefs", "basisRefs"] } },
    "evidenceContracts": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "coExecutionConstraints": { "type": "array", "items": { "type": "object" } },
    "goalExecutionIRHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    { "if": { "properties": { "schemaVersion": { "const": "GoalExecutionIR/v1" } } }, "then": { "properties": {
      "obligations": { "items": { "$ref": "#/$defs/obligation" } }, "evidenceContracts": { "minItems": 1 }, "artifacts": { "minItems": 1 },
      "atomicTasks": { "items": { "properties": { "taskId": { "pattern": "^TASK-[0-9]{3}$" } } } }
    } } },
    { "if": { "properties": { "schemaVersion": { "enum": ["GoalExecutionIR/v2", "GoalExecutionIR/v3"] } } }, "then": { "properties": {
      "obligations": { "items": { "$ref": "#/$defs/typedObligation" } },
      "logicalScopes": { "required": ["pathRestrictions"], "properties": { "pathRestrictions": { "type": "array", "items": { "$ref": "#/$defs/pathRestriction" } } } },
      "semanticSource": { "required": ["schemaVersion"], "properties": { "schemaVersion": { "enum": ["StandaloneGoalSemanticIR/v2", "requirements-contract-semantic-ir/v2"] } } }
    } } },
    { "if": { "properties": { "profile": { "const": "requirements_backed" } } }, "then": { "required": ["requirementsLineage"], "not": { "required": ["standaloneLineage"] } } },
    { "if": { "properties": { "profile": { "const": "requirements_backed" }, "schemaVersion": { "const": "GoalExecutionIR/v1" } } }, "then": { "properties": { "coExecutionConstraints": { "minItems": 1 } } } },
    { "if": { "properties": { "profile": { "const": "requirements_backed" }, "schemaVersion": { "enum": ["GoalExecutionIR/v2", "GoalExecutionIR/v3"] } } }, "then": { "properties": { "semanticSource": {
      "required": ["schemaVersion", "typedSourceAuthority", "typedSourceGraphHash"], "properties": { "schemaVersion": { "const": "requirements-contract-semantic-ir/v2" }, "typedSourceGraphHash": { "$ref": "#/$defs/hash" } }
    } } } },
    { "if": { "properties": { "profile": { "const": "standalone" }, "schemaVersion": { "enum": ["GoalExecutionIR/v2", "GoalExecutionIR/v3"] } } }, "then": { "properties": {
      "semanticSource": { "properties": { "schemaVersion": { "const": "StandaloneGoalSemanticIR/v2" } } },
      "technicalAuthority": { "required": ["internalSemanticGateHash"], "properties": {
        "internalSemanticGateHash": { "$ref": "#/$defs/hash" }
      } }
    } } },
    { "if": { "properties": { "schemaVersion": { "const": "GoalExecutionIR/v3" } } }, "then": {
      "required": ["sourceLineage"],
      "properties": {
        "logicalSpecSpans": { "minItems": 1, "items": { "$ref": "#/$defs/logicalSpecSpan" } }
      }
    } },
    { "if": { "properties": { "profile": { "const": "requirements_backed" }, "schemaVersion": { "const": "GoalExecutionIR/v3" } } }, "then": {
      "properties": { "semanticSource": { "required": ["canonicalRequirementGraphRef"] } }
    } },
    { "if": { "properties": { "profile": { "const": "standalone" } } }, "then": {
      "required": ["standaloneLineage"],
      "not": { "required": ["requirementsLineage"] },
      "properties": { "technicalAuthority": { "required": ["internalSemanticGateHash"], "properties": {
        "internalSemanticGateHash": { "$ref": "#/$defs/hash" }
      } } }
    } }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "canonicalRequirementGraphRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "graphSchemaVersion", "graphHash", "semanticHash", "sourceAuthorityHash", "lintReceiptHash"],
      "properties": {
        "schemaVersion": { "const": "CanonicalRequirementGraphRef/v1" },
        "graphSchemaVersion": { "const": "CanonicalRequirementGraph/v2" },
        "graphHash": { "$ref": "#/$defs/hash" },
        "semanticHash": { "$ref": "#/$defs/hash" },
        "sourceAuthorityHash": { "$ref": "#/$defs/hash" },
        "lintReceiptHash": { "$ref": "#/$defs/hash" },
        "typedSourceGraphHash": { "$ref": "#/$defs/hash" },
        "upstreamCanonicalRequirementGraphHash": { "$ref": "#/$defs/hash" },
        "derivationManifestHash": { "$ref": "#/$defs/hash" }
      }
    },
    "logicalSpecSpan": {
      "type": "object",
      "required": ["specSpanId", "boundObligationIds"],
      "properties": {
        "specSpanId": { "type": "string", "minLength": 1 },
        "authorityClass": { "type": "string", "minLength": 1 },
        "normalizedClaimHash": { "$ref": "#/$defs/hash" },
        "boundTypedSourceGraphHash": { "$ref": "#/$defs/hash" },
        "sourceArtifactId": { "type": "string", "minLength": 1 },
        "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByteExclusive": { "type": "integer", "minimum": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "exactTextHash": { "$ref": "#/$defs/hash" },
        "boundObligationIds": { "$ref": "#/$defs/strings", "minItems": 1 },
        "canonicalNodeRefs": { "$ref": "#/$defs/strings" },
        "sourceDocumentGraphHash": { "$ref": "#/$defs/hash" },
        "canonicalRequirementGraphHash": { "$ref": "#/$defs/hash" }
      },
      "oneOf": [
        { "required": ["sourceArtifactId", "sourceSnapshotHash", "startByte", "endByteExclusive", "lineStart", "lineEnd", "exactTextHash"] },
        { "not": { "anyOf": [
          { "required": ["sourceArtifactId"] }, { "required": ["sourceSnapshotHash"] },
          { "required": ["startByte"] }, { "required": ["endByteExclusive"] },
          { "required": ["exactTextHash"] }
        ] } }
      ]
    },
    "sourceLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "authorities", "logicalSpecSpanRefs", "logicalSpecSpanSetHash", "lineageHash"],
      "properties": {
        "schemaVersion": { "const": "GoalExecutionSourceLineage/v1" },
        "authorities": { "type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["authorityKind", "authorityId", "authorityHash", "logicalSpecSpanRefs"],
          "properties": {
            "authorityKind": { "enum": ["standalone_source_document", "requirements_semantic_ir"] },
            "authorityId": { "type": "string", "minLength": 1 },
            "authorityHash": { "$ref": "#/$defs/hash" },
            "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
            "sourceDocumentGraphHash": { "$ref": "#/$defs/hash" },
            "canonicalRequirementGraphHash": { "$ref": "#/$defs/hash" },
            "canonicalSemanticHash": { "$ref": "#/$defs/hash" },
            "typedSourceGraphHash": { "$ref": "#/$defs/hash" },
            "sourceBindingHash": { "$ref": "#/$defs/hash" },
            "upstreamCanonicalRequirementGraphHash": { "$ref": "#/$defs/hash" },
            "logicalSpecSpanRefs": { "$ref": "#/$defs/strings", "minItems": 1 }
          },
          "allOf": [
            { "if": { "properties": { "authorityKind": { "const": "requirements_semantic_ir" } } }, "then": { "required": ["typedSourceGraphHash", "canonicalRequirementGraphHash", "canonicalSemanticHash"] } },
            { "if": { "properties": { "authorityKind": { "const": "standalone_source_document" } }, "anyOf": [
              { "required": ["canonicalRequirementGraphHash"] },
              { "required": ["canonicalSemanticHash"] }
            ] }, "then": { "required": ["canonicalRequirementGraphHash", "canonicalSemanticHash"] } }
          ]
        } },
        "logicalSpecSpanRefs": { "$ref": "#/$defs/strings", "minItems": 1 },
        "logicalSpecSpanSetHash": { "$ref": "#/$defs/hash" },
        "lineageHash": { "$ref": "#/$defs/hash" }
      }
    },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "taskExecution": {
      "type": "object", "additionalProperties": false,
      "required": ["executionClass", "ownedProductionPaths", "sourceRefs"],
      "properties": {
        "executionClass": { "enum": ["executable_child", "aggregate_only"] },
        "ownedProductionPaths": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/strings", "minItems": 1 },
        "aggregateGatePhase": { "enum": ["post_child_execution", "final_aggregate"] },
        "aggregateValidationCommands": { "$ref": "#/$defs/strings", "minItems": 1 },
        "aggregateValidationCommandsValue": { "type": "string", "minLength": 1 }
      },
      "allOf": [{ "if": { "properties": { "executionClass": { "const": "aggregate_only" } } },
        "then": { "required": ["aggregateGatePhase", "aggregateValidationCommands"],
          "properties": { "ownedProductionPaths": { "enum": ["none", "`none`"] } } } }]
    },
    "pathRestriction": {
      "type": "object", "required": ["constraintId", "kind", "canonicalValue", "scope", "applicableMustRefs", "applicableAtomRefs", "sourceRefs", "premiseRefs", "declarationStatus"],
      "properties": {
        "constraintId": { "type": "string", "minLength": 1 }, "kind": { "const": "STOP" }, "canonicalValue": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["declared", "global"] }, "applicableMustRefs": { "$ref": "#/$defs/strings", "minItems": 1 }, "applicableAtomRefs": { "$ref": "#/$defs/strings" },
        "sourceRefs": { "$ref": "#/$defs/strings", "minItems": 1 }, "premiseRefs": { "$ref": "#/$defs/strings", "minItems": 1 }, "declarationStatus": { "const": "source_declared_not_executed" }
      }
    },
    "typedObligation": {
      "type": "object",
      "required": ["obligationId", "kind", "text", "sourceRefs", "atomRefs", "evidenceClaimRefs", "normativeStrength", "polarity", "executionRole", "conditions", "applicability"],
      "properties": {
        "obligationId": { "type": "string", "minLength": 1 }, "kind": { "enum": ["MUST", "NEG", "OUT", "FR", "NFR", "ACCEPTANCE", "FAILURE", "EDGE", "GUIDANCE", "PERMISSION", "COMPOSITE", "DEFINITION"] },
        "text": { "type": "string", "minLength": 1 }, "oracle": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/strings", "minItems": 1 }, "atomRefs": { "$ref": "#/$defs/strings" }, "evidenceClaimRefs": { "$ref": "#/$defs/strings" },
        "normativeStrength": { "enum": ["must", "should", "may", "mixed", "descriptive"] },
        "polarity": { "enum": ["required", "forbidden", "permitted", "preserve", "mixed", "descriptive"] },
        "executionRole": { "enum": ["action", "requirement", "acceptance", "binding", "definition", "boundary", "guidance"] },
        "taskExecution": { "$ref": "#/$defs/taskExecution" },
        "normativeClauses": { "type": "array", "items": { "type": "object" } },
        "conditions": { "type": "array", "items": { "type": "object", "required": ["text", "sourceRefs", "state"], "properties": {
          "text": { "type": "string", "minLength": 1 }, "sourceRefs": { "$ref": "#/$defs/strings", "minItems": 1 }, "state": { "const": "unevaluated" }
        } } },
        "applicability": { "type": "object", "required": ["scope", "sourceRefs"], "properties": {
          "scope": { "enum": ["global", "obligations", "source_scope"] }, "sourceRefs": { "$ref": "#/$defs/strings", "minItems": 1 },
          "obligationRefs": { "$ref": "#/$defs/strings", "minItems": 1 }, "sourceScope": { "type": "object", "required": ["kind"] }
        }, "allOf": [
          { "if": { "properties": { "scope": { "const": "obligations" } } }, "then": { "required": ["obligationRefs"] } },
          { "if": { "properties": { "scope": { "const": "source_scope" } } }, "then": { "required": ["sourceScope"] } }
        ] }
      },
      "allOf": [
        { "if": { "properties": { "executionRole": { "const": "action" } } }, "then": { "required": ["oracle"], "properties": { "atomRefs": { "minItems": 1 }, "normativeStrength": { "const": "must" } } }, "else": { "not": { "required": ["oracle"] }, "properties": { "atomRefs": { "maxItems": 0 } } } },
        { "if": { "properties": { "normativeStrength": { "const": "may" } } }, "then": { "properties": { "kind": { "const": "PERMISSION" }, "polarity": { "const": "permitted" }, "executionRole": { "const": "guidance" } } } },
        { "if": { "properties": { "normativeStrength": { "const": "should" } } }, "then": { "properties": { "kind": { "const": "GUIDANCE" }, "executionRole": { "const": "guidance" } } } }
      ]
    },
    "obligation": {
      "type": "object",
      "required": ["obligationId", "kind", "text", "oracle", "sourceRefs", "atomRefs", "evidenceClaimRefs"],
      "properties": {
        "obligationId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["MUST", "NEG", "OUT", "FR", "NFR", "ACCEPTANCE", "FAILURE", "EDGE"] },
        "text": { "type": "string", "minLength": 1 },
        "oracle": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/strings" },
        "atomRefs": { "$ref": "#/$defs/strings" },
        "evidenceClaimRefs": { "$ref": "#/$defs/strings" }
      }
    },
    "task": {
      "type": "object",
      "required": ["taskId", "title", "obligationRefs", "atomRefs", "expectedEffortMinutes", "upperBoundEffortMinutes", "effortBasisRefs", "oracle"],
      "properties": {
        "taskId": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "taskExecution": { "$ref": "#/$defs/taskExecution" },
        "obligationRefs": { "$ref": "#/$defs/strings" },
        "atomRefs": { "$ref": "#/$defs/strings" },
        "expectedEffortMinutes": { "type": "integer", "minimum": 1, "maximum": 180 },
        "upperBoundEffortMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
        "effortBasisRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "oracle": { "type": "string", "minLength": 1 }
      }
    }
  }
}

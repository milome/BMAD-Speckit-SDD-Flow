{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/standalone-source-plan-profile.schema.json",
  "title": "StandaloneSourcePlanProfile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profileId", "profileVersion", "sourcePlanVersion", "templatePath", "templateHash", "profileHash", "metadataRequired", "nodeKinds", "requirementOwnerKinds", "ownedNodeKinds", "identity", "parser", "commonNodeRequiredFields", "requiredFieldsByKind", "referenceFields", "ownerRules", "globalBinding", "purpose", "confirmation", "normalization", "hashing"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "StandaloneSourcePlanProfile/v1" },
    "profileId": { "const": "standalone-source-plan" },
    "profileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourcePlanVersion": { "const": "standalone-source-plan/v1" },
    "templatePath": { "type": "string", "minLength": 1 },
    "templateHash": { "$ref": "#/$defs/hash" },
    "profileHash": { "$ref": "#/$defs/hash" },
    "metadataRequired": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "nodeKinds": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } },
    "requirementOwnerKinds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } },
    "ownedNodeKinds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } },
    "identity": { "type": "object", "additionalProperties": false, "required": ["domainPattern", "canonicalPattern", "sourcePlanIdPattern", "provenanceOnlyPrefixes", "legacyAliasPattern"], "properties": { "domainPattern": { "type": "string" }, "canonicalPattern": { "type": "string" }, "sourcePlanIdPattern": { "type": "string" }, "provenanceOnlyPrefixes": { "$ref": "#/$defs/nonEmptyUniqueStrings" }, "legacyAliasPattern": { "type": "string" } } },
    "parser": { "type": "object", "additionalProperties": false, "required": ["metadataFence", "nodeFence", "headingTextIsSemantic", "sectionOrderIsSemantic", "explicitFieldsOverrideProse"], "properties": { "metadataFence": { "type": "string" }, "nodeFence": { "type": "string" }, "headingTextIsSemantic": { "const": false }, "sectionOrderIsSemantic": { "const": false }, "explicitFieldsOverrideProse": { "const": true } } },
    "commonNodeRequiredFields": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "requiredFieldsByKind": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonEmptyUniqueStrings" } },
    "referenceFields": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } } },
    "ownerRules": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } } },
    "globalBinding": { "type": "object", "additionalProperties": false, "required": ["wildcardRefsForbidden", "metadataFlag", "metadataAuthorityRefsField", "nodeAuthorityRefField"], "properties": { "wildcardRefsForbidden": { "const": true }, "metadataFlag": { "type": "string" }, "metadataAuthorityRefsField": { "type": "string" }, "nodeAuthorityRefField": { "type": "string" } } },
    "purpose": { "type": "object", "additionalProperties": false, "required": ["intendedConsumer", "allowedPurpose", "conflictingTargets"], "properties": { "intendedConsumer": { "const": "goal-execution-contract-generator" }, "allowedPurpose": { "const": "implementation_execution" }, "conflictingTargets": { "$ref": "#/$defs/nonEmptyUniqueStrings" } } },
    "confirmation": { "type": "object", "additionalProperties": false, "required": ["implementationConfirmationRequired", "confirmedRequirementsRoutesKeepNativeGates", "confirmedSourceAdapterTarget", "canonicalGraphLintRequired", "sharedCompilerStages"], "properties": { "implementationConfirmationRequired": { "const": false }, "confirmedRequirementsRoutesKeepNativeGates": { "const": true }, "confirmedSourceAdapterTarget": { "const": "CanonicalRequirementGraph/v1" }, "canonicalGraphLintRequired": { "const": true }, "sharedCompilerStages": { "type": "array", "prefixItems": [{ "const": "compileGoalExecutionIR" }, { "const": "compileGoalExecutionClosure" }, { "const": "renderGoalExecutionProjection" }], "items": false, "minItems": 3, "maxItems": 3 } } },
    "normalization": { "type": "object", "additionalProperties": false, "required": ["normativeStrengthValues", "polarityValues", "notDoneProjectionKind", "unownedSemanticChildFailure", "purposeConflictFailure", "taskExecutionClassValues", "commandDeclarationClasses"], "properties": { "normativeStrengthValues": { "$ref": "#/$defs/nonEmptyUniqueStrings" }, "polarityValues": { "$ref": "#/$defs/nonEmptyUniqueStrings" }, "notDoneProjectionKind": { "const": "OUT" }, "unownedSemanticChildFailure": { "const": "source_semantic_owner_missing" }, "purposeConflictFailure": { "const": "source_plan_purpose_conflict" }, "taskExecutionClassValues": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["executable_child", "aggregate_only"] } }, "commandDeclarationClasses": { "type": "array", "prefixItems": [{ "const": "executable_expression" }, { "const": "source_command_set" }, { "const": "conditional_selector" }], "items": false, "minItems": 3, "maxItems": 3 } } },
    "hashing": { "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalizer", "selfHashField"], "properties": { "algorithm": { "const": "sha256" }, "canonicalizer": { "const": "canonical-control-plane/v1" }, "selfHashField": { "const": "profileHash" } } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "kind": { "enum": ["REQ", "NFR", "NEG", "OUT", "TASK", "AC", "PATH", "CMD", "EVD", "ART", "DEP", "STOP"] },
    "nonEmptyUniqueStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}

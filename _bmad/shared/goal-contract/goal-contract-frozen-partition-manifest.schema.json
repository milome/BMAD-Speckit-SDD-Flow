{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/goal-contract-frozen-partition-manifest.schema.json",
  "title": "Goal Contract Frozen Partition Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "goalId", "goalExecutionIRHash", "hardCompatibilityPolicyHash", "selectorPolicyHash", "partitionOutcome", "partitionCount", "topologicalOrder", "partitions", "partitionManifestHash"],
  "properties": {
    "schemaVersion": { "const": "GoalContractPartitionManifest/v1" },
    "profile": { "enum": ["requirements_backed", "standalone"] },
    "goalId": { "type": "string", "minLength": 1 },
    "goalExecutionIRHash": { "$ref": "#/$defs/hash" },
    "hardCompatibilityPolicyHash": { "$ref": "#/$defs/hash" },
    "selectorPolicyHash": { "$ref": "#/$defs/hash" },
    "partitionOutcome": { "enum": ["complete_valid", "bounded_valid"] },
    "partitionCount": { "type": "integer", "minimum": 2 },
    "topologicalOrder": { "$ref": "#/$defs/strings" },
    "partitions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partitionId", "componentRefs", "taskRefs", "traceSliceRefs", "obligationRefs", "dependencyPartitionRefs", "expectedEffortMinutes", "upperBoundEffortMinutes", "ownedPaths", "forbiddenPaths", "childContractRef", "childExecutionPackageRef"],
        "properties": {
          "partitionId": { "type": "string", "pattern": "^PART-[0-9]{3}$" },
          "componentRefs": { "$ref": "#/$defs/strings" },
          "taskRefs": { "$ref": "#/$defs/strings" },
          "traceSliceRefs": { "$ref": "#/$defs/strings" },
          "obligationRefs": { "$ref": "#/$defs/strings" },
          "dependencyPartitionRefs": { "$ref": "#/$defs/stringsAllowEmpty" },
          "expectedEffortMinutes": { "type": "integer", "minimum": 1 },
          "upperBoundEffortMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
          "ownedPaths": { "$ref": "#/$defs/stringsAllowEmpty" },
          "forbiddenPaths": { "$ref": "#/$defs/stringsAllowEmpty" },
          "childContractRef": { "$ref": "#/$defs/hashRef" },
          "childExecutionPackageRef": { "$ref": "#/$defs/hashRef" }
        }
      }
    },
    "partitionManifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stringsAllowEmpty": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "hashRef": { "type": "object", "additionalProperties": false, "required": ["path", "hash"], "properties": { "path": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/hash" } } }
  }
}

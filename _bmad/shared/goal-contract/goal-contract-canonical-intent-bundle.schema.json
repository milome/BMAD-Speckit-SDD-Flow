{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goal-contract-canonical-intent-bundle/v1",
  "title": "Goal Contract Canonical Intent Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityState",
    "sourceCompositionPolicyHash",
    "orderedSourceSnapshotSetHash",
    "sourceAuthorityBundleHash",
    "canonicalIntentIR",
    "canonicalIntentSemanticHash",
    "specSpanRegistry",
    "sourceObligationGraph",
    "sourceObligationGraphHash",
    "subordinateCoverage",
    "compilerIdentity",
    "canonicalIntentBundleHash"
  ],
  "properties": {
    "schemaVersion": {
      "enum": ["goal-contract-canonical-intent-bundle/v1", "goal-contract-canonical-intent-bundle/v2"]
    },
    "authorityState": {
      "enum": [
        "candidate_only",
        "authoritative"
      ]
    },
    "sourceCompositionPolicyHash": {
      "$ref": "#/$defs/hash"
    },
    "orderedSourceSnapshotSetHash": {
      "$ref": "#/$defs/hash"
    },
    "sourceAuthorityBundleHash": {
      "$ref": "#/$defs/hash"
    },
    "canonicalIntentIR": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/intentRecord"
      }
    },
    "canonicalIntentSemanticHash": {
      "$ref": "#/$defs/hash"
    },
    "specSpanRegistry": {
      "type": "object"
    },
    "sourceObligationGraph": {
      "$ref": "#/$defs/sourceObligationGraph"
    },
    "sourceObligationGraphHash": {
      "$ref": "#/$defs/hash"
    },
    "subordinateCoverage": {
      "type": "object"
    },
    "compilerIdentity": {
      "$ref": "#/$defs/compilerIdentity"
    },
    "intentAuthorityEnvelope": {
      "type": "object"
    },
    "authorityAttestationHash": {
      "$ref": "#/$defs/hash"
    },
    "canonicalIntentBundleHash": {
      "$ref": "#/$defs/hash"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "goal-contract-canonical-intent-bundle/v2" } } },
      "then": { "properties": {
        "canonicalIntentIR": { "items": { "$ref": "#/$defs/typedIntentRequirements" } },
        "sourceObligationGraph": { "properties": { "obligations": { "items": { "$ref": "#/$defs/typedIntentRequirements" } } } },
        "compilerIdentity": { "properties": { "compilerVersion": { "const": "goal-contract-canonical-intent-compiler/v2" } } }
      } },
      "else": { "properties": {
        "canonicalIntentIR": { "items": { "$ref": "#/$defs/legacyIntentRequirements" } },
        "sourceObligationGraph": { "properties": { "obligations": { "items": { "$ref": "#/$defs/legacyIntentRequirements" } } } },
        "compilerIdentity": { "properties": { "compilerVersion": { "const": "goal-contract-canonical-intent-compiler/v1" } } }
      } }
    },
    {
      "if": {
        "properties": {
          "authorityState": {
            "const": "authoritative"
          }
        }
      },
      "then": {
        "required": [
          "intentAuthorityEnvelope",
          "authorityAttestationHash"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "intentAuthorityEnvelope"
              ]
            },
            {
              "required": [
                "authorityAttestationHash"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "typedIntentRequirements": {
      "required": ["sourceRootId", "normativeStrength", "required", "executionRole", "conditions", "applicability", "applicabilityState", "normativeClauses", "provenanceRefs", "sourceBlockRefs", "clauseRefs", "typedRefs", "commandDeclarations"],
      "properties": { "polarity": { "enum": ["required", "forbidden", "permitted", "preserve", "mixed", "descriptive"] } }
    },
    "legacyIntentRequirements": {
      "properties": {
        "polarity": { "enum": ["positive", "negative"] },
        "target": { "minLength": 1 },
        "sourceRootId": false, "normativeStrength": false, "required": false, "executionRole": false, "conditions": false, "applicability": false, "applicabilityState": false,
        "normativeClauses": false, "provenanceRefs": false, "sourceBlockRefs": false, "clauseRefs": false, "typedRefs": false,
        "taskRefs": false, "acceptanceRefs": false, "commandRefs": false, "evidenceRefs": false, "atomicGroupRefs": false, "commandDeclarations": false
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taskExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionClass", "ownedProductionPaths", "sourceRefs"],
      "properties": {
        "executionClass": { "enum": ["executable_child", "aggregate_only"] },
        "ownedProductionPaths": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
        "aggregateGatePhase": { "enum": ["post_child_execution", "final_aggregate"] },
        "aggregateValidationCommands": { "$ref": "#/$defs/stringArray", "minItems": 1 },
        "aggregateValidationCommandsValue": { "type": "string", "minLength": 1 }
      },
      "allOf": [{
        "if": { "properties": { "executionClass": { "const": "aggregate_only" } } },
        "then": {
          "required": ["aggregateGatePhase", "aggregateValidationCommands"],
          "properties": { "ownedProductionPaths": { "enum": ["none", "`none`"] } }
        }
      }]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "intentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentRecordId",
        "declaredSourceId",
        "classification",
        "ownership",
        "referenceTargetId",
        "sourceArtifactId",
        "sourceSnapshotHash",
        "sourceRole",
        "namespace",
        "sourceOrder",
        "sourceKind",
        "polarity",
        "subject",
        "action",
        "target",
        "applicabilityCondition",
        "requiredOutcome",
        "semanticCoordinateKey",
        "semanticOwnershipKey",
        "dependencyRefs",
        "specSpanRefs"
      ],
      "properties": {
        "intentRecordId": {
          "type": "string",
          "minLength": 1
        },
        "declaredSourceId": {
          "$ref": "#/$defs/nullableString"
        },
        "classification": {
          "enum": [
            "positive",
            "negative",
            "boundary",
            "evidence",
            "dependency",
            "applicability",
            "context"
          ]
        },
        "ownership": {
          "enum": [
            "owned_obligation",
            "cross_source_reference"
          ]
        },
        "referenceTargetId": {
          "$ref": "#/$defs/nullableString"
        },
        "sourceArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSnapshotHash": {
          "$ref": "#/$defs/hash"
        },
        "sourceRole": {
          "enum": [
            "primary_implementation_authority",
            "subordinate_component_specification"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "sourceOrder": {
          "type": "integer",
          "minimum": 0
        },
        "sourceKind": {
          "type": "string",
          "minLength": 1
        },
        "polarity": {
          "enum": [
            "positive",
            "negative", "required", "forbidden", "permitted", "preserve", "mixed", "descriptive"
          ]
        },
        "sourceRootId": { "type": "string", "minLength": 1 },
        "normativeStrength": { "enum": ["must", "should", "may", "mixed", "descriptive"] },
        "required": { "type": "boolean" },
        "applicabilityState": { "enum": ["applicable", "conditional"] },
        "executionRole": { "enum": ["action", "requirement", "acceptance", "binding", "definition", "boundary", "guidance"] },
        "taskExecution": { "$ref": "#/$defs/taskExecution" },
        "conditions": { "type": "array", "items": { "type": "object", "required": ["text", "state", "sourceRefs"], "properties": {
          "text": { "type": "string", "minLength": 1 }, "state": { "const": "unevaluated" }, "sourceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 }
        } } },
        "applicability": { "type": "object", "required": ["scope", "sourceRefs"], "properties": {
          "scope": { "enum": ["obligations", "source_scope"] }, "sourceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
          "obligationRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 }, "sourceScope": { "type": "object" }
        }, "allOf": [
          { "if": { "properties": { "scope": { "const": "obligations" } } }, "then": { "required": ["obligationRefs"] } },
          { "if": { "properties": { "scope": { "const": "source_scope" } } }, "then": { "required": ["sourceScope"] } }
        ] },
        "normativeClauses": { "type": "array", "items": { "type": "object" } },
        "commandDeclarations": { "type": "array", "items": { "type": "object", "required": ["id", "invocation", "sourceRef", "executionStatus"], "properties": {
          "id": { "type": "string", "minLength": 1 }, "invocation": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "object" }, "executionStatus": { "const": "source_declared_not_executed" }
        } } },
        "provenanceRefs": { "$ref": "#/$defs/stringArray" },
        "sourceBlockRefs": { "$ref": "#/$defs/stringArray" },
        "clauseRefs": { "$ref": "#/$defs/stringArray" },
        "typedRefs": { "type": "array", "items": { "type": "object" } },
        "taskRefs": { "$ref": "#/$defs/stringArray" },
        "acceptanceRefs": { "$ref": "#/$defs/stringArray" },
        "commandRefs": { "$ref": "#/$defs/stringArray" },
        "evidenceRefs": { "$ref": "#/$defs/stringArray" },
        "atomicGroupRefs": { "$ref": "#/$defs/stringArray" },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 0
        },
        "applicabilityCondition": {
          "type": "string",
          "minLength": 1
        },
        "requiredOutcome": {
          "type": "string",
          "minLength": 1
        },
        "semanticCoordinateKey": {
          "$ref": "#/$defs/hash"
        },
        "semanticOwnershipKey": {
          "$ref": "#/$defs/hash"
        },
        "dependencyRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "specSpanRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^spec-span-[0-9a-f]{64}$"
          }
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromId",
        "toId",
        "dependencyId"
      ],
      "properties": {
        "fromId": {
          "type": "string",
          "minLength": 1
        },
        "toId": {
          "type": "string",
          "minLength": 1
        },
        "dependencyId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "crossSourceReferenceEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromId",
        "toId",
        "targetId"
      ],
      "properties": {
        "fromId": {
          "type": "string",
          "minLength": 1
        },
        "toId": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceObligationGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "orderedSourceSnapshotSetHash",
        "specSpanRegistryHash",
        "obligations",
        "dependencyEdges",
        "crossSourceReferenceEdges"
      ],
      "properties": {
        "schemaVersion": {
          "const": "goal-contract-unified-source-obligation-graph/v1"
        },
        "orderedSourceSnapshotSetHash": {
          "$ref": "#/$defs/hash"
        },
        "specSpanRegistryHash": {
          "$ref": "#/$defs/hash"
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/intentRecord"
          }
        },
        "dependencyEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyEdge"
          }
        },
        "crossSourceReferenceEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crossSourceReferenceEdge"
          }
        }
      }
    },
    "schemaArtifactHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaName",
        "schemaArtifactHash"
      ],
      "properties": {
        "schemaName": {
          "type": "string",
          "minLength": 1
        },
        "schemaArtifactHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "compilerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilerVersion",
        "schemaArtifactHashes",
        "compilerIdentityHash"
      ],
      "properties": {
        "compilerVersion": {
          "enum": ["goal-contract-canonical-intent-compiler/v1", "goal-contract-canonical-intent-compiler/v2"]
        },
        "schemaArtifactHashes": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/schemaArtifactHash"
          }
        },
        "compilerIdentityHash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}

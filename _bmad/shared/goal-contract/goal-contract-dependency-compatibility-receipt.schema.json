{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "masterSourceHash",
    "sourceSnapshotHash",
    "partitionManifestHash",
    "dependentPartitionId",
    "predecessorPartitionId",
    "predecessorCompletionReceiptHash",
    "predecessorOwnedArtifactPath",
    "predecessorArtifactHash",
    "currentArtifactHash",
    "compatibilityDomain",
    "preservedAcceptanceIds",
    "invalidatedAcceptanceIds",
    "compatibilityCommands",
    "decision",
    "blockingReasons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "goal-contract-dependency-compatibility-receipt/v1"
    },
    "masterSourceHash": { "$ref": "#/$defs/hash" },
    "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
    "partitionManifestHash": { "$ref": "#/$defs/hash" },
    "dependentPartitionId": { "$ref": "#/$defs/partitionId" },
    "predecessorPartitionId": { "$ref": "#/$defs/partitionId" },
    "predecessorCompletionReceiptHash": { "$ref": "#/$defs/hash" },
    "predecessorOwnedArtifactPath": { "type": "string", "minLength": 1 },
    "predecessorArtifactHash": { "$ref": "#/$defs/hash" },
    "currentArtifactHash": { "$ref": "#/$defs/hash" },
    "compatibilityDomain": { "type": "string", "minLength": 1 },
    "preservedAcceptanceIds": { "$ref": "#/$defs/ids" },
    "invalidatedAcceptanceIds": { "$ref": "#/$defs/ids" },
    "compatibilityCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/commandResult" }
    },
    "decision": { "enum": ["pass", "blocked"] },
    "blockingReasons": { "$ref": "#/$defs/ids" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "pass" } } },
      "then": {
        "properties": {
          "blockingReasons": { "maxItems": 0 },
          "invalidatedAcceptanceIds": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "blocked" } } },
      "then": { "properties": { "blockingReasons": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "partitionId": {
      "type": "string",
      "pattern": "^partition-[0-9a-f]{64}$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "argv",
        "cwd",
        "exitCode",
        "stdoutHash",
        "stderrHash",
        "artifactHashes"
      ],
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer" },
        "stdoutHash": { "$ref": "#/$defs/hash" },
        "stderrHash": { "$ref": "#/$defs/hash" },
        "artifactHashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/hash" }
        }
      }
    }
  }
}

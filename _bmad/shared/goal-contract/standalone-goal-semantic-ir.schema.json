{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/standalone-goal-semantic-ir.schema.json",
  "title": "Standalone Goal Semantic IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourcePlanHash", "semanticPayload", "standaloneGoalSemanticIRHash"],
  "properties": {
    "schemaVersion": { "enum": ["StandaloneGoalSemanticIR/v1", "StandaloneGoalSemanticIR/v2"] },
    "sourcePlanHash": { "$ref": "#/$defs/hash" },
    "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
    "semanticPayload": {
      "type": "object",
      "anyOf": [
        { "required": ["obligations", "atoms", "logicalSpecSpans", "executionConstraints", "architecture"], "not": { "required": ["schemaVersion"] } },
        { "$ref": "#/$defs/semanticDictionary" }
      ],
      "properties": {
        "obligations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "atoms": { "type": "array", "items": { "type": "object" } },
        "logicalSpecSpans": { "type": "array", "items": { "type": "object" } },
        "executionConstraints": { "type": "array", "items": { "type": "object" } },
        "architecture": { "type": "object" }
      }
    },
    "standaloneGoalSemanticIRHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [{ "if": { "properties": { "schemaVersion": { "const": "StandaloneGoalSemanticIR/v2" } } },
    "then": { "required": ["sourceSnapshotHash"] }, "else": { "not": { "required": ["sourceSnapshotHash"] } } },
    { "if": { "properties": { "schemaVersion": { "const": "StandaloneGoalSemanticIR/v1" } } },
    "then": { "properties": { "semanticPayload": { "required": ["obligations", "atoms", "logicalSpecSpans", "executionConstraints", "architecture"], "not": { "required": ["schemaVersion"] },
      "properties": { "atoms": { "minItems": 1 }, "executionConstraints": { "minItems": 1 } } } } } }],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "semanticDictionary": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "nodes", "root", "expandedBytes", "expandedHash"],
      "properties": {
        "schemaVersion": { "const": "GoalSemanticDictionary/v1" }, "nodes": { "type": "array", "minItems": 1 },
        "nodeEncoding": { "enum": ["GoalDictionaryNodes/base36-v1", "GoalDictionaryNodes/base36-run-v2"] },
        "root": { "type": "integer", "minimum": 0 }, "expandedBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "expandedHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

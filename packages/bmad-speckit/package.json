{
  "name": "bmad-speckit",
  "version": "2.2.0",
  "description": "Internal BMAD-Speckit CLI workspace bundled by bmad-speckit-sdd-flow",
  "private": true,
  "bin": {
    "bmad-speckit": "bin/bmad-speckit.js",
    "bmad-speckit-init": "bin/bmad-speckit-init.js"
  },
  "files": [
    "README.md",
    "bin/",
    "dist/",
    "_bmad/",
    "node_modules/@bmad-speckit/"
  ],
  "scripts": {
    "build:main-agent-dist": "node scripts/build-main-agent-dist.cjs",
    "prepack": "npm run build:scoring --prefix ../.. && npm run build:runtime-context --prefix ../.. && npm run build:runtime-emit --prefix ../.. && npm run build:ralph-method --prefix ../.. && npm run build:main-agent-dist && node scripts/prepublish-check.cjs --pack-session --silent",
    "postpack": "node scripts/cleanup-packed-bmad.cjs",
    "prepublishOnly": "node scripts/prepublish-check.cjs",
    "test": "node scripts/run-node-tests.cjs",
    "verify:requirements-contract-source-writes": "node dist/main-agent/source-authority/scripts/verify-requirements-contract-source-writes.js"
  },
  "keywords": [
    "bmad",
    "speckit",
    "sdd",
    "init"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bundleDependencies": [
    "@bmad-speckit/schema",
    "@bmad-speckit/scoring",
    "@bmad-speckit/runtime-context",
    "@bmad-speckit/runtime-emit",
    "@bmad-speckit/ralph-method"
  ],
  "devDependencies": {
    "nock": "^15.0.0"
  },
  "dependencies": {
    "@bmad-speckit/ralph-method": "2.1.9",
    "@bmad-speckit/runtime-context": "2.1.9",
    "@bmad-speckit/runtime-emit": "2.1.9",
    "@bmad-speckit/schema": "2.1.9",
    "@bmad-speckit/scoring": "2.1.9",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "boxen": "^8.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "js-yaml": "^4.3.1",
    "ora": "^8.0.1",
    "tar": "^7.0.0"
  }
}

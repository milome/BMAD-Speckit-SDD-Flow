{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-audit-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "judgeProtocolVersion", "scopeSemanticHash", "judgeInputSemanticHash", "semanticIrRef", "semanticAuditSliceRefs", "mandatoryDimensionIds", "coverageSemanticHash", "packetHash"],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-judge-audit-packet/v3" },
    "judgeProtocolVersion": { "const": "requirements-judge-protocol/v1" },
    "scopeSemanticHash": { "$ref": "#/$defs/hash" },
    "judgeInputSemanticHash": { "$ref": "#/$defs/hash" },
    "semanticIrRef": { "$ref": "#/$defs/contentRef" },
    "semanticAuditSliceRefs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "schemaVersion", "semanticHash", "contentRef"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "string", "minLength": 1 },
          "semanticHash": { "$ref": "#/$defs/hash" },
          "contentRef": { "$ref": "#/$defs/contentRef" }
        }
      }
    },
    "mandatoryDimensionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "coverageSemanticHash": { "$ref": "#/$defs/hash" },
    "packetHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "contentHash", "byteLength", "mediaType", "recordRelativePath"],
      "properties": {
        "schemaVersion": { "const": "requirements-content-ref/v1" },
        "contentHash": { "$ref": "#/$defs/hash" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1 },
        "recordRelativePath": { "type": "string", "pattern": "^authoring/objects/sha256/[a-f0-9]{2}/[a-f0-9]{62}$" }
      }
    }
  }
}

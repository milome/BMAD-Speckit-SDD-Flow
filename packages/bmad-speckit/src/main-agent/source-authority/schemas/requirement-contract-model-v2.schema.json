{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirement-contract-model-v2.schema.json",
  "title": "Requirement Contract Model v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activationState",
    "recordId",
    "requirementSetId",
    "sourceAuthorityHash",
    "semanticModelHash",
    "edgeTypeRegistryHash",
    "authority",
    "semanticBodies",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirement-contract-model/v2"
    },
    "activationState": {
      "const": "inactive_schema_boundary"
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "requirementSetId": {
      "type": "string",
      "minLength": 1
    },
    "sourceAuthorityHash": {
      "$ref": "#/$defs/sha256"
    },
    "semanticModelHash": {
      "$ref": "#/$defs/sha256"
    },
    "edgeTypeRegistryHash": {
      "$ref": "#/$defs/sha256"
    },
    "authority": {
      "const": "none"
    },
    "semanticBodies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/semanticNode"
      }
    },
    "edges": {
      "type": "object",
      "propertyNames": {
        "pattern": "^EDGE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/normalizedEdge"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/v[0-9]+$"
    },
    "proofRefArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "normalizedApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reasonCode", "proofRefs"],
      "properties": {
        "decision": {
          "const": "applicable"
        },
        "reasonCode": {
          "const": "source_authorized"
        },
        "proofRefs": {
          "$ref": "#/$defs/proofRefArray"
        }
      }
    },
    "semanticNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeType",
        "bodySchemaVersion",
        "bodyHash",
        "applicability",
        "proofBindings"
      ],
      "properties": {
        "nodeType": {
          "enum": [
            "requirement",
            "scenario",
            "sequence_step",
            "participant",
            "branch",
            "ordering",
            "temporal",
            "target",
            "task",
            "red",
            "oracle",
            "acceptance",
            "evidence_requirement",
            "proof"
          ]
        },
        "bodySchemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "bodyHash": {
          "$ref": "#/$defs/sha256"
        },
        "applicability": {
          "$ref": "#/$defs/normalizedApplicability"
        },
        "proofBindings": {
          "$ref": "#/$defs/proofRefArray"
        }
      }
    },
    "normalizedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeType",
        "fromRef",
        "fromHash",
        "toRef",
        "toHash",
        "applicability",
        "proofBindings",
        "edgeHash"
      ],
      "properties": {
        "edgeType": {
          "type": "string",
          "minLength": 1
        },
        "fromRef": {
          "type": "string",
          "minLength": 1
        },
        "fromHash": {
          "$ref": "#/$defs/sha256"
        },
        "toRef": {
          "type": "string",
          "minLength": 1
        },
        "toHash": {
          "$ref": "#/$defs/sha256"
        },
        "applicability": {
          "$ref": "#/$defs/normalizedApplicability"
        },
        "proofBindings": {
          "$ref": "#/$defs/proofRefArray"
        },
        "edgeHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "endLine"],
      "properties": {
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sourceSpan", "sourceHash", "sourceRequirementId", "headingPath"],
      "properties": {
        "sourcePath": {
          "$ref": "#/$defs/nullableString"
        },
        "sourceSpan": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceHash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRequirementId": {
          "$ref": "#/$defs/nullableString"
        },
        "headingPath": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "trigger",
        "preconditions",
        "action",
        "postconditions",
        "invariants",
        "thresholds"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/nullableString"
        },
        "trigger": {
          "$ref": "#/$defs/nullableString"
        },
        "preconditions": {
          "$ref": "#/$defs/stringArray"
        },
        "action": {
          "$ref": "#/$defs/nullableString"
        },
        "postconditions": {
          "$ref": "#/$defs/stringArray"
        },
        "invariants": {
          "$ref": "#/$defs/stringArray"
        },
        "thresholds": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityState", "derivation", "decisionReceiptRef"],
      "properties": {
        "authorityState": {
          "enum": ["source_grounded", "human_confirmed", "derived", "unresolved", "invalid"]
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "decisionReceiptRef": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCode"],
      "properties": {
        "state": {
          "enum": ["applicable", "not_applicable", "unresolved", "invalid"]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "question", "blocking"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "oracleRef", "commandRefs", "expectedObservationRefs"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "oracleRef": {
          "$ref": "#/$defs/nullableString"
        },
        "commandRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "expectedObservationRefs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRefs", "artifactRefs", "traceEdgeRefs"],
      "properties": {
        "targetRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "artifactRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "traceEdgeRefs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "schemaVersion",
        "text",
        "source",
        "semantics",
        "authority",
        "applicability",
        "unresolved",
        "verification",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:MUST-(?:FR|NFR)-[0-9]{3}|NEG-[0-9]{3}|OUT-[0-9]{3})$"
        },
        "kind": {
          "enum": ["functional", "nonfunctional", "negative", "out_of_scope"]
        },
        "schemaVersion": {
          "const": "requirement-contract-requirement/v2"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "semantics": {
          "$ref": "#/$defs/semantics"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolvedItem"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "fromRef", "toRef"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "fromRef": {
          "type": "string",
          "minLength": 1
        },
        "toRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

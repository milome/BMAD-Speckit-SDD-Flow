{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-sequence-trace-matrix.schema.json",
  "title": "Requirements Contract Sequence Trace Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requirementSetId",
    "sequenceContractHash",
    "semanticModelHash",
    "rows",
    "criticalStepCount",
    "rowCount",
    "matrixHash"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-sequence-trace-matrix/v1" },
    "requirementSetId": { "$ref": "#/$defs/nonEmptyString" },
    "sequenceContractHash": { "$ref": "#/$defs/sha256" },
    "semanticModelHash": { "$ref": "#/$defs/sha256" },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "criticalStepCount": { "type": "integer", "minimum": 0 },
    "rowCount": { "type": "integer", "minimum": 0 },
    "matrixHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "refArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "order",
        "participantRef",
        "critical",
        "sideEffect",
        "requirementRefs",
        "scenarioRefs",
        "branchRefs",
        "targetRefs",
        "symbolRefs",
        "taskRefs",
        "redRefs",
        "oracleRefs",
        "commandRefs",
        "evidenceRefs",
        "proofRefs",
        "rowHash"
      ],
      "properties": {
        "stepId": { "$ref": "#/$defs/nonEmptyString" },
        "order": { "type": "integer", "minimum": 1 },
        "participantRef": { "$ref": "#/$defs/nonEmptyString" },
        "critical": { "type": "boolean" },
        "sideEffect": { "$ref": "#/$defs/nonEmptyString" },
        "compensationForStepRef": { "$ref": "#/$defs/nonEmptyString" },
        "requirementRefs": { "$ref": "#/$defs/refArray" },
        "scenarioRefs": { "$ref": "#/$defs/refArray" },
        "branchRefs": { "$ref": "#/$defs/refArray" },
        "targetRefs": { "$ref": "#/$defs/refArray" },
        "symbolRefs": { "$ref": "#/$defs/refArray" },
        "taskRefs": { "$ref": "#/$defs/refArray" },
        "redRefs": { "$ref": "#/$defs/refArray" },
        "oracleRefs": { "$ref": "#/$defs/refArray" },
        "commandRefs": { "$ref": "#/$defs/refArray" },
        "evidenceRefs": { "$ref": "#/$defs/refArray" },
        "proofRefs": { "$ref": "#/$defs/refArray" },
        "rowHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

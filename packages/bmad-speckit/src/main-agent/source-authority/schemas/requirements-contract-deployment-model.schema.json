{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-deployment-model.schema.json",
  "title": "Requirements Contract Deployment Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelId",
    "authority",
    "nodes",
    "connections",
    "modelHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-deployment-model/v1"
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "hash"],
      "properties": {
        "kind": {
          "enum": [
            "infrastructure_manifest",
            "runtime_manifest",
            "deployment_workflow",
            "architecture_record",
            "decision_receipt"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "configurationHash",
          "proofRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "runtime_service",
              "runtime_process",
              "data_store",
              "message_broker",
              "external_dependency",
              "runtime_configuration"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "configurationHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "proofRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "configurationHash",
          "proofRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "request",
              "event",
              "data_access",
              "network",
              "configuration",
              "dependency"
            ]
          },
          "configurationHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "proofRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "modelHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-final-acceptance-scope-manifest.schema.json",
  "title": "Requirements Contract Final Acceptance Scope Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actorClass",
    "judgeRole",
    "purpose",
    "attemptId",
    "includedRequirementRefs",
    "requiredCoverageUnits",
    "mandatoryDimensions",
    "requiredVetoItems",
    "allowedEvidenceRefs",
    "explicitOutOfScope",
    "priorFindingLedgerHash",
    "sourceAuthorityHash",
    "policyHash",
    "kernelImplementationLineage",
    "scopeManifestHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-final-acceptance-scope-manifest/v1"
    },
    "actorClass": { "const": "final_acceptance_judge" },
    "judgeRole": { "const": "final_acceptance_judge" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "attemptId": { "$ref": "#/$defs/nonEmptyString" },
    "includedRequirementRefs": { "$ref": "#/$defs/stringSet" },
    "requiredCoverageUnits": { "$ref": "#/$defs/stringSet" },
    "mandatoryDimensions": { "$ref": "#/$defs/stringSet" },
    "requiredVetoItems": { "$ref": "#/$defs/stringSet" },
    "allowedEvidenceRefs": { "$ref": "#/$defs/stringSet" },
    "explicitOutOfScope": { "$ref": "#/$defs/nonEmptyStringSet" },
    "priorFindingLedgerHash": { "$ref": "#/$defs/sha256" },
    "sourceAuthorityHash": { "$ref": "#/$defs/sha256" },
    "policyHash": { "$ref": "#/$defs/sha256" },
    "kernelImplementationLineage": { "$ref": "#/$defs/kernelLineage" },
    "scopeManifestHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "kernelLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "parentGoalContractHash",
        "partitionManifestHash",
        "partitionSetHash",
        "sourceCompositionPolicyHash",
        "sourceSnapshotSetHash",
        "specSpanRegistryHash",
        "sourceObligationGraphHash",
        "compilerIdentityHash",
        "goalCampaignClosureReceiptHash",
        "subcontractClosureSetHash",
        "subcontractClosureReceiptHashes",
        "governedByteManifestHash",
        "productionReachabilityReceiptHash",
        "installedRuntimeIdentity",
        "packageAndConsumerIdentity"
      ],
      "properties": {
        "applicability": { "const": "applicable" },
        "parentGoalContractHash": { "$ref": "#/$defs/sha256" },
        "partitionManifestHash": { "$ref": "#/$defs/sha256" },
        "partitionSetHash": { "$ref": "#/$defs/sha256" },
        "sourceCompositionPolicyHash": { "$ref": "#/$defs/sha256" },
        "sourceSnapshotSetHash": { "$ref": "#/$defs/sha256" },
        "specSpanRegistryHash": { "$ref": "#/$defs/sha256" },
        "sourceObligationGraphHash": { "$ref": "#/$defs/sha256" },
        "compilerIdentityHash": { "$ref": "#/$defs/sha256" },
        "goalCampaignClosureReceiptHash": { "$ref": "#/$defs/sha256" },
        "subcontractClosureSetHash": { "$ref": "#/$defs/sha256" },
        "subcontractClosureReceiptHashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "governedByteManifestHash": { "$ref": "#/$defs/sha256" },
        "productionReachabilityReceiptHash": { "$ref": "#/$defs/sha256" },
        "installedRuntimeIdentity": { "$ref": "#/$defs/nonEmptyString" },
        "packageAndConsumerIdentity": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}

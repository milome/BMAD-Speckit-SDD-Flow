{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-requirements-effective-pass-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actorClass",
    "judgeRole",
    "attemptKeyHash",
    "requestHash",
    "scopeManifestHash",
    "evidenceManifestHash",
    "providerInvocationReceiptHash",
    "promptTemplateHash",
    "assessmentSchemaHash",
    "providerConfigurationHash",
    "ledgerEntryHash",
    "requirementsAuditAggregateHash",
    "effectivePassConditions",
    "writeSemantics",
    "writer",
    "decisionFieldOrigin",
    "decision",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-effective-pass-receipt/v1" },
    "actorClass": { "const": "requirements_critical_auditor_judge" },
    "judgeRole": { "const": "requirements_critical_auditor" },
    "attemptKeyHash": { "$ref": "#/$defs/hash" },
    "requestHash": { "$ref": "#/$defs/hash" },
    "scopeManifestHash": { "$ref": "#/$defs/hash" },
    "evidenceManifestHash": { "$ref": "#/$defs/hash" },
    "providerInvocationReceiptHash": { "$ref": "#/$defs/hash" },
    "promptTemplateHash": { "$ref": "#/$defs/hash" },
    "assessmentSchemaHash": { "$ref": "#/$defs/hash" },
    "providerConfigurationHash": { "$ref": "#/$defs/hash" },
    "ledgerEntryHash": { "$ref": "#/$defs/hash" },
    "requirementsAuditAggregateHash": { "$ref": "#/$defs/hash" },
    "effectivePassConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleSpecificRequestValid",
        "attemptKeyCurrent",
        "modelVerdictPermitsRequirementsPass",
        "observedCoverageExactlyEqualsFrozenScope",
        "unassessedScopesIsEmpty",
        "missingEvidenceIsEmpty",
        "blockingConditionsIsEmpty",
        "validatedGapsIsEmpty",
        "unresolvedPriorFindingsIsEmpty",
        "everyPriorFindingHasCurrentDisposition",
        "everyRequirementsVetoEvaluatedAndPassed",
        "scopeManifestCurrent",
        "evidenceManifestCurrent",
        "providerInvocationReceiptCurrent",
        "promptTemplateBindingCurrent",
        "assessmentSchemaBindingCurrent",
        "providerConfigurationBindingCurrent",
        "noReplayOrDuplicateIdentity"
      ],
      "properties": {
        "roleSpecificRequestValid": { "const": true },
        "attemptKeyCurrent": { "const": true },
        "modelVerdictPermitsRequirementsPass": { "const": true },
        "observedCoverageExactlyEqualsFrozenScope": { "const": true },
        "unassessedScopesIsEmpty": { "const": true },
        "missingEvidenceIsEmpty": { "const": true },
        "blockingConditionsIsEmpty": { "const": true },
        "validatedGapsIsEmpty": { "const": true },
        "unresolvedPriorFindingsIsEmpty": { "const": true },
        "everyPriorFindingHasCurrentDisposition": { "const": true },
        "everyRequirementsVetoEvaluatedAndPassed": { "const": true },
        "scopeManifestCurrent": { "const": true },
        "evidenceManifestCurrent": { "const": true },
        "providerInvocationReceiptCurrent": { "const": true },
        "promptTemplateBindingCurrent": { "const": true },
        "assessmentSchemaBindingCurrent": { "const": true },
        "providerConfigurationBindingCurrent": { "const": true },
        "noReplayOrDuplicateIdentity": { "const": true }
      }
    },
    "writeSemantics": { "const": "create_only" },
    "writer": { "const": "package_owned_requirements_effective_pass_writer" },
    "decisionFieldOrigin": { "const": "package_calculated" },
    "decision": { "const": "pass" },
    "receiptHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

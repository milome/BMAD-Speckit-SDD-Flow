{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-selection-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transactionId",
    "auditAttemptId",
    "providerRegistryHash",
    "publicProviderConfigHash",
    "capabilityReceiptHash",
    "providerRef",
    "configuredBaseUrlHash",
    "transport",
    "apiStyle",
    "model",
    "credentialRevision",
    "independenceClass",
    "blindReview",
    "allowPassAuthority",
    "runtimeFallbackAllowed",
    "rubricHash",
    "systemPromptHash",
    "sourceHash",
    "traceHash",
    "redHash",
    "baseEvidenceHash",
    "auditUniverseHash",
    "baseJudgeInputBundleHash",
    "authorizedChallengeDerivationProtocolHash",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-judge-selection-receipt/v1"
    },
    "transactionId": { "type": "string", "minLength": 1 },
    "auditAttemptId": { "type": "string", "minLength": 1 },
    "providerRegistryHash": { "$ref": "#/$defs/hash" },
    "publicProviderConfigHash": { "$ref": "#/$defs/hash" },
    "capabilityReceiptHash": { "$ref": "#/$defs/hash" },
    "providerRef": { "const": "local-sonnet-judge" },
    "configuredBaseUrlHash": { "$ref": "#/$defs/hash" },
    "transport": { "const": "openai-compatible" },
    "apiStyle": { "const": "chat_completions" },
    "model": { "const": "claude-sonnet-5" },
    "credentialRevision": { "type": "integer", "minimum": 1 },
    "independenceClass": { "const": "different_provider_different_model" },
    "blindReview": { "const": true },
    "allowPassAuthority": { "const": false },
    "runtimeFallbackAllowed": { "const": false },
    "rubricHash": { "$ref": "#/$defs/hash" },
    "systemPromptHash": { "$ref": "#/$defs/hash" },
    "sourceHash": { "$ref": "#/$defs/hash" },
    "traceHash": { "$ref": "#/$defs/hash" },
    "redHash": { "$ref": "#/$defs/hash" },
    "baseEvidenceHash": { "$ref": "#/$defs/hash" },
    "auditUniverseHash": { "$ref": "#/$defs/hash" },
    "baseJudgeInputBundleHash": { "$ref": "#/$defs/hash" },
    "authorizedChallengeDerivationProtocolHash": { "$ref": "#/$defs/hash" },
    "decision": { "const": "frozen" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

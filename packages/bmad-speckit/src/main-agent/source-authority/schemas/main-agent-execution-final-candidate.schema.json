{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/main-agent-execution-final-candidate.schema.json",
  "title": "Execution Final Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "goalId",
    "goalExecutionIRHash",
    "activeRunPointerHash",
    "activationRecordHash",
    "executionPackageHashes",
    "campaignClosureHash",
    "implementationContextHash",
    "requiredDimensionIds",
    "requiredArtifactIds",
    "requiredObligationIds",
    "requiredExecutionResultIds",
    "requiredCommandIds",
    "requiredEvidenceIds",
    "requiredDeliveryClaimIds",
    "artifacts",
    "executionResults",
    "commands",
    "evidence",
    "deliveryClaims",
    "executionFinalCandidateHash"
  ],
  "properties": {
    "schemaVersion": { "const": "ExecutionFinalCandidate/v1" },
    "profile": { "enum": ["requirements_backed", "standalone"] },
    "goalId": { "type": "string", "pattern": "^GOAL-[A-F0-9]{16}$" },
    "goalExecutionIRHash": { "$ref": "#/$defs/hash" },
    "requirementsLineage": { "type": "object", "minProperties": 1 },
    "standaloneLineage": { "type": "object", "minProperties": 1 },
    "activeRunPointerHash": { "$ref": "#/$defs/hash" },
    "activationRecordHash": { "$ref": "#/$defs/hash" },
    "executionPackageHashes": { "$ref": "#/$defs/hashes" },
    "campaignClosureHash": { "$ref": "#/$defs/hash" },
    "implementationContextHash": { "$ref": "#/$defs/hash" },
    "requiredDimensionIds": { "$ref": "#/$defs/ids" },
    "requiredArtifactIds": { "$ref": "#/$defs/ids" },
    "requiredObligationIds": { "$ref": "#/$defs/ids" },
    "requiredExecutionResultIds": { "$ref": "#/$defs/ids" },
    "requiredCommandIds": { "$ref": "#/$defs/ids" },
    "requiredEvidenceIds": { "$ref": "#/$defs/ids" },
    "requiredDeliveryClaimIds": { "$ref": "#/$defs/ids" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "artifactKind", "path", "hash"],
        "properties": {
          "artifactId": { "$ref": "#/$defs/id" },
          "artifactKind": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/id" },
          "hash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "executionResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executionResultId", "executionAuthorityId", "closureHash"],
        "properties": {
          "executionResultId": { "$ref": "#/$defs/id" },
          "executionAuthorityId": { "$ref": "#/$defs/id" },
          "closureHash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "normalizedInvocationHash"],
        "properties": {
          "commandId": { "$ref": "#/$defs/id" },
          "normalizedInvocationHash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "evidenceKind", "path", "hash"],
        "properties": {
          "evidenceId": { "$ref": "#/$defs/id" },
          "evidenceKind": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/id" },
          "hash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "deliveryClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deliveryClaimId", "claimHash", "evidenceIds"],
        "properties": {
          "deliveryClaimId": { "$ref": "#/$defs/id" },
          "claimHash": { "$ref": "#/$defs/hash" },
          "evidenceIds": { "$ref": "#/$defs/ids" }
        }
      }
    },
    "executionFinalCandidateHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "profile": { "const": "requirements_backed" } },
        "required": ["profile"]
      },
      "then": { "required": ["requirementsLineage"], "not": { "required": ["standaloneLineage"] } }
    },
    {
      "if": { "properties": { "profile": { "const": "standalone" } }, "required": ["profile"] },
      "then": { "required": ["standaloneLineage"], "not": { "required": ["requirementsLineage"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    }
  }
}

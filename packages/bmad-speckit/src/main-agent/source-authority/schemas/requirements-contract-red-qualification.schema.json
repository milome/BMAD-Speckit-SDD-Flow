{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-red-qualification.schema.json",
  "title": "Requirements Contract RED Qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requirementId",
    "testId",
    "semanticModelHash",
    "baselineSnapshotHash",
    "testSourceHash",
    "fixtureHash",
    "oracleHash",
    "exitCode",
    "failurePhase",
    "assertionSiteMatched",
    "expectedFailure",
    "observedFailure",
    "classification",
    "blockingReasons",
    "qualificationHash"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-red-qualification/v1" },
    "requirementId": { "$ref": "#/$defs/nonEmptyString" },
    "testId": { "$ref": "#/$defs/nonEmptyString" },
    "semanticModelHash": { "$ref": "#/$defs/sha256" },
    "baselineSnapshotHash": { "$ref": "#/$defs/sha256" },
    "testSourceHash": { "$ref": "#/$defs/sha256" },
    "fixtureHash": { "$ref": "#/$defs/sha256" },
    "oracleHash": { "$ref": "#/$defs/sha256" },
    "sequenceContractHash": { "$ref": "#/$defs/sha256" },
    "exitCode": { "type": "integer" },
    "failurePhase": {
      "enum": ["assertion", "compile", "fixture", "environment", "setup"]
    },
    "assertionSiteMatched": { "type": "boolean" },
    "expectedFailure": { "type": "string" },
    "observedFailure": { "type": "string" },
    "classification": {
      "enum": ["EXPECTED_RED", "INVALID_RED", "ALREADY_GREEN", "INCONCLUSIVE"]
    },
    "blockingReasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "qualificationHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}

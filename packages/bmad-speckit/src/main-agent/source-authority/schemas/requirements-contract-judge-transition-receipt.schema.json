{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-transition-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transitionId",
    "actorClass",
    "judgeRole",
    "attemptKeyHash",
    "fromState",
    "toState",
    "ledgerEntryHash",
    "evidenceManifestHash",
    "blockingReasonHash",
    "effectivePassReceiptRef",
    "writeSemantics",
    "writer",
    "decisionFieldOrigin",
    "decision",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-judge-transition-receipt/v1" },
    "transitionId": { "type": "string", "minLength": 1 },
    "actorClass": {
      "enum": ["requirements_critical_auditor_judge", "final_acceptance_judge"]
    },
    "judgeRole": {
      "enum": ["requirements_critical_auditor", "final_acceptance_judge"]
    },
    "attemptKeyHash": { "$ref": "#/$defs/hash" },
    "fromState": { "type": "string", "minLength": 1 },
    "toState": { "type": "string", "minLength": 1 },
    "ledgerEntryHash": { "$ref": "#/$defs/hash" },
    "evidenceManifestHash": { "$ref": "#/$defs/hash" },
    "blockingReasonHash": { "$ref": "#/$defs/hash" },
    "effectivePassReceiptRef": { "$ref": "#/$defs/effectivePassRef" },
    "writeSemantics": { "const": "create_only" },
    "writer": { "const": "package_owned_judge_transition_writer" },
    "decisionFieldOrigin": { "const": "package_calculated" },
    "decision": { "enum": ["pass", "block"] },
    "receiptHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actorClass": { "const": "requirements_critical_auditor_judge" }
        }
      },
      "then": {
        "properties": {
          "judgeRole": { "const": "requirements_critical_auditor" },
          "effectivePassReceiptRef": {
            "properties": {
              "schemaVersion": {
                "const": "requirements-effective-pass-receipt/v1"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "actorClass": { "const": "final_acceptance_judge" } }
      },
      "then": {
        "properties": {
          "judgeRole": { "const": "final_acceptance_judge" },
          "effectivePassReceiptRef": {
            "properties": {
              "schemaVersion": {
                "const": "final-acceptance-effective-pass-receipt/v1"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "effectivePassRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "path", "hash"],
      "properties": {
        "schemaVersion": {
          "enum": [
            "requirements-effective-pass-receipt/v1",
            "final-acceptance-effective-pass-receipt/v1"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-clean-materialization-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "materializationRunId",
    "materializationRoot",
    "receiptPath",
    "sourceSnapshotPaths",
    "sourceSnapshotHash",
    "requirementSetId",
    "requirementRefs",
    "transactionId",
    "implementationAttemptId",
    "architectureAuditAttemptId",
    "activePhaseAuditAttemptId",
    "contractHash",
    "acceptanceRefs",
    "traceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-clean-materialization-input/v1"
    },
    "materializationRunId": {
      "type": "string",
      "pattern": "^RUN-[A-Za-z0-9._-]+$"
    },
    "materializationRoot": { "type": "string", "minLength": 1 },
    "receiptPath": { "type": "string", "minLength": 1 },
    "sourceSnapshotPaths": { "$ref": "#/$defs/nonEmptyStrings" },
    "sourceSnapshotHash": { "$ref": "#/$defs/sha256" },
    "requirementSetId": { "type": "string", "minLength": 1 },
    "requirementRefs": { "$ref": "#/$defs/nonEmptyStrings" },
    "transactionId": {
      "type": "string",
      "pattern": "^TX-[A-Za-z0-9._-]+$"
    },
    "implementationAttemptId": {
      "type": "string",
      "pattern": "^IMPL-ATTEMPT-[A-Z0-9][A-Z0-9._-]*$"
    },
    "architectureAuditAttemptId": {
      "type": "string",
      "pattern": "^AUDIT-[A-Za-z0-9._-]+$"
    },
    "activePhaseAuditAttemptId": {
      "type": "string",
      "pattern": "^AUDIT-[A-Za-z0-9._-]+$"
    },
    "contractHash": { "$ref": "#/$defs/sha256" },
    "acceptanceRefs": { "$ref": "#/$defs/nonEmptyStrings" },
    "traceRefs": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

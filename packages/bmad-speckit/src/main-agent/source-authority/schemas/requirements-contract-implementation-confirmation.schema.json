{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-implementation-confirmation.schema.json",
  "title": "Requirements Contract Implementation Confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractSchemaVersion",
    "status",
    "recordId",
    "requirementSetId",
    "entryFlow",
    "entryFlowClass",
    "workflowAdapter",
    "contractAuthoringRequired",
    "confirmationLanguage",
    "confirmationProfile",
    "requiredViewPacks",
    "optionalViewPacks",
    "confirmedAt",
    "confirmedBy",
    "sourceDocumentHash",
    "implementationConfirmationHash",
    "confirmationRender",
    "preConfirmationDrilldown",
    "applicability",
    "must",
    "notDone",
    "mustNot",
    "evidence",
    "openQuestions",
    "failurePaths",
    "edgeCases",
    "acceptanceTests",
    "e2eSuites",
    "traceRows",
    "sequenceViews",
    "flowViews",
    "edgeCaseViews",
    "boundaryViews",
    "targetModificationPaths",
    "requirementBoundary",
    "artifactAutomationPlan",
    "requiredCommands",
    "suggestedCommands",
    "requiredContractChecks",
    "implementationTasks",
    "closeoutReadinessPreview"
  ],
  "properties": {
    "contractSchemaVersion": { "const": 1 },
    "status": {
      "enum": [
        "draft",
        "draft_updated_not_confirmation_ready",
        "user_confirmed",
        "reconfirm_required"
      ]
    },
    "recordId": { "$ref": "#/$defs/nonEmpty" },
    "requirementSetId": { "$ref": "#/$defs/nonEmpty" },
    "entryFlow": { "enum": ["story", "bugfix", "standalone_tasks"] },
    "entryFlowClass": {
      "enum": ["full_story_entry", "corrective_entry", "task_packet_entry"]
    },
    "workflowAdapter": { "enum": ["bmad", "speckit", "direct", "legacy"] },
    "contractAuthoringRequired": { "type": "boolean" },
    "confirmationLanguage": { "enum": ["zh-CN", "en-US", "bilingual"] },
    "confirmationProfile": { "const": "implementation_confirmation" },
    "requiredViewPacks": { "$ref": "#/$defs/stringRefs" },
    "optionalViewPacks": { "$ref": "#/$defs/stringRefs" },
    "confirmedAt": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "confirmedBy": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "sourceDocumentHash": { "$ref": "#/$defs/sha256" },
    "implementationConfirmationHash": { "$ref": "#/$defs/sha256" },
    "confirmationRender": { "$ref": "#/$defs/confirmationRender" },
    "preConfirmationDrilldown": { "$ref": "#/$defs/preConfirmationDrilldown" },
    "applicability": { "$ref": "#/$defs/applicability" },
    "governanceEventTypeRegistryPolicy": {
      "$ref": "#/$defs/governanceEventTypeRegistryPolicy"
    },
    "governanceEventTypeRegistry": {
      "type": "array",
      "items": { "$ref": "#/$defs/governanceEventType" }
    },
    "controlledIngestWriterRegistry": {
      "type": "array",
      "items": { "$ref": "#/$defs/controlledIngestWriter" }
    },
    "activeRequirementResolution": { "$ref": "#/$defs/referenceModule" },
    "functionalResumeFailureCaseRegistry": {
      "type": "array",
      "items": { "$ref": "#/$defs/referenceModule" }
    },
    "scoringDashboardSft": { "$ref": "#/$defs/referenceModule" },
    "scriptsAndHooks": { "$ref": "#/$defs/referenceModule" },
    "must": {
      "type": "array",
      "items": { "$ref": "#/$defs/mustRow" }
    },
    "notDone": {
      "type": "array",
      "items": { "$ref": "#/$defs/notDoneRow" }
    },
    "mustNot": {
      "type": "array",
      "items": { "$ref": "#/$defs/mustNotRow" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRow" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "$ref": "#/$defs/openQuestionRow" }
    },
    "failurePaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/failurePathRow" }
    },
    "edgeCases": {
      "type": "array",
      "items": { "$ref": "#/$defs/edgeCaseRow" }
    },
    "acceptanceTests": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptanceRow" }
    },
    "e2eSuites": {
      "type": "array",
      "items": { "$ref": "#/$defs/e2eRow" }
    },
    "traceRows": {
      "type": "array",
      "items": { "$ref": "#/$defs/traceRow" }
    },
    "sequenceViews": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewRow" }
    },
    "flowViews": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewRow" }
    },
    "edgeCaseViews": {
      "type": "array",
      "items": { "$ref": "#/$defs/edgeCaseViewRow" }
    },
    "boundaryViews": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewRow" }
    },
    "targetModificationPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/targetRow" }
    },
    "requirementBoundary": { "$ref": "#/$defs/requirementBoundary" },
    "artifactAutomationPlan": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactPlanRow" }
    },
    "currentTargetMap": { "$ref": "#/$defs/currentTargetMap" },
    "requiredCommands": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandRow" }
    },
    "suggestedCommands": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandRow" }
    },
    "requiredContractChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/contractCheckRow" }
    },
    "implementationTasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskRow" }
    },
    "aiTddContractExecutionManifestProjection": {
      "$ref": "#/$defs/aiTddProjection"
    },
    "closeoutReadinessPreview": { "$ref": "#/$defs/closeoutPreview" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "user_confirmed" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "confirmedAt": { "type": "string", "format": "date-time" },
          "confirmedBy": { "$ref": "#/$defs/nonEmpty" }
        }
      },
      "else": {
        "properties": {
          "confirmedAt": { "type": "null" },
          "confirmedBy": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "governanceEvents": {
                "properties": { "applies": { "const": true } },
                "required": ["applies"]
              }
            },
            "required": ["governanceEvents"]
          }
        },
        "required": ["applicability"]
      },
      "then": {
        "required": [
          "governanceEventTypeRegistryPolicy",
          "governanceEventTypeRegistry",
          "controlledIngestWriterRegistry"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "runtimeRecovery": {
                "anyOf": [
                  {
                    "properties": { "applies": { "const": true } },
                    "required": ["applies"]
                  },
                  {
                    "properties": {
                      "requiresFunctionalResumeFailureCaseRegistry": { "const": true }
                    },
                    "required": ["requiresFunctionalResumeFailureCaseRegistry"]
                  },
                  {
                    "properties": {
                      "activeRequirementResolutionRequired": { "const": true }
                    },
                    "required": ["activeRequirementResolutionRequired"]
                  }
                ]
              }
            },
            "required": ["runtimeRecovery"]
          }
        },
        "required": ["applicability"]
      },
      "then": {
        "required": [
          "activeRequirementResolution",
          "functionalResumeFailureCaseRegistry"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "scoringDashboardSft": {
                "properties": { "applies": { "const": true } },
                "required": ["applies"]
              }
            },
            "required": ["scoringDashboardSft"]
          }
        },
        "required": ["applicability"]
      },
      "then": { "required": ["scoringDashboardSft"] }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "currentTargetMap": {
                "properties": { "applies": { "const": true } },
                "required": ["applies"]
              }
            },
            "required": ["currentTargetMap"]
          }
        },
        "required": ["applicability"]
      },
      "then": { "required": ["currentTargetMap"] }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "scriptsAndHooks": {
                "properties": { "applies": { "const": true } },
                "required": ["applies"]
              }
            },
            "required": ["scriptsAndHooks"]
          }
        },
        "required": ["applicability"]
      },
      "then": { "required": ["scriptsAndHooks"] }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "aiTddContractGate": {
                "properties": { "applies": { "const": true } },
                "required": ["applies"]
              }
            },
            "required": ["aiTddContractGate"]
          }
        },
        "required": ["applicability"]
      },
      "then": { "required": ["aiTddContractExecutionManifestProjection"] }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableNonEmpty": {
      "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
    },
    "nullableSha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "stringRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "confirmationRender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "htmlPath",
        "summaryPath",
        "reportPath",
        "htmlHash",
        "confirmationPhrase"
      ],
      "properties": {
        "htmlPath": { "$ref": "#/$defs/nullableNonEmpty" },
        "summaryPath": { "$ref": "#/$defs/nullableNonEmpty" },
        "reportPath": { "$ref": "#/$defs/nullableNonEmpty" },
        "htmlHash": { "$ref": "#/$defs/nullableSha256" },
        "confirmationPhrase": { "$ref": "#/$defs/nullableNonEmpty" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "packetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "status"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "hash": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["synchronized", "blocked", "stale"] }
      }
    },
    "preConfirmationDrilldown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticKernelRef",
        "mustDecompositionPacketRef",
        "criticalAuditor",
        "packetSourceReconciliation",
        "preRenderGateReportPath"
      ],
      "properties": {
        "semanticKernelRef": { "$ref": "#/$defs/artifactRef" },
        "mustDecompositionPacketRef": { "$ref": "#/$defs/packetRef" },
        "criticalAuditor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumRounds",
            "consecutiveNoNewGapRounds",
            "latestReceiptHash",
            "convergenceVerdict"
          ],
          "properties": {
            "minimumRounds": { "type": "integer", "minimum": 1 },
            "consecutiveNoNewGapRounds": { "type": "integer", "minimum": 0 },
            "latestReceiptHash": { "$ref": "#/$defs/sha256" },
            "convergenceVerdict": {
              "enum": [
                "audit_not_run",
                "blocked",
                "blocked_by_validated_gap_fix",
                "bounded_no_new_gap"
              ]
            }
          }
        },
        "packetSourceReconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reportPath", "verdict"],
          "properties": {
            "reportPath": { "$ref": "#/$defs/nonEmpty" },
            "verdict": { "enum": ["pass", "block", "stale"] }
          }
        },
        "preRenderGateReportPath": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "applicabilityDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies", "reasonCode"],
      "properties": {
        "applies": { "type": "boolean" },
        "reasonCode": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "runtimeRecoveryApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "reasonCode",
        "requiresFunctionalResumeFailureCaseRegistry",
        "activeRequirementResolutionRequired",
        "retiredContextSurfaceForbidden"
      ],
      "properties": {
        "applies": { "type": "boolean" },
        "reasonCode": { "$ref": "#/$defs/nonEmpty" },
        "requiresFunctionalResumeFailureCaseRegistry": { "type": "boolean" },
        "activeRequirementResolutionRequired": { "type": "boolean" },
        "retiredContextSurfaceForbidden": { "type": "boolean" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governanceEvents",
        "runtimeRecovery",
        "scoringDashboardSft",
        "currentTargetMap",
        "scriptsAndHooks",
        "aiTddContractGate"
      ],
      "properties": {
        "governanceEvents": { "$ref": "#/$defs/applicabilityDomain" },
        "runtimeRecovery": { "$ref": "#/$defs/runtimeRecoveryApplicability" },
        "scoringDashboardSft": { "$ref": "#/$defs/applicabilityDomain" },
        "currentTargetMap": { "$ref": "#/$defs/applicabilityDomain" },
        "scriptsAndHooks": { "$ref": "#/$defs/applicabilityDomain" },
        "aiTddContractGate": { "$ref": "#/$defs/applicabilityDomain" }
      }
    },
    "mustRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidenceRefs", "coveredByTraceRows"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "text": { "$ref": "#/$defs/nonEmpty" },
        "evidenceRefs": { "$ref": "#/$defs/stringRefs" },
        "coveredByTraceRows": { "$ref": "#/$defs/stringRefs" },
        "coveredBySequenceViews": { "$ref": "#/$defs/stringRefs" },
        "upstreamRequirementIds": { "$ref": "#/$defs/stringRefs" },
        "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
        "perMustOracle": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "notDoneRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "text": { "$ref": "#/$defs/nonEmpty" },
        "evidenceRefs": { "$ref": "#/$defs/stringRefs" },
        "whyItBlocksCompletion": { "$ref": "#/$defs/nonEmpty" },
        "negativeAssertionRequired": { "type": "boolean" },
        "coveredByFailurePath": { "$ref": "#/$defs/stringRefs" }
      }
    },
    "mustNotRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "text": { "$ref": "#/$defs/nonEmpty" },
        "scopeBoundary": { "$ref": "#/$defs/nonEmpty" },
        "userApprovalRequiredIfChanged": { "type": "boolean" },
        "coveredByBoundaryView": { "$ref": "#/$defs/stringRefs" }
      }
    },
    "evidenceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "requiredCommandRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "text": { "$ref": "#/$defs/nonEmpty" },
        "gate": { "$ref": "#/$defs/nonEmpty" },
        "oracle": { "$ref": "#/$defs/nonEmpty" },
        "requiredCommandRefs": { "$ref": "#/$defs/stringRefs" },
        "artifactRefs": { "$ref": "#/$defs/stringRefs" },
        "acceptanceType": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "openQuestionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "question": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["open", "resolved"] },
        "decisionReceiptRef": { "$ref": "#/$defs/nullableNonEmpty" }
      }
    },
    "failurePathRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "trigger": { "$ref": "#/$defs/nonEmpty" },
        "expectedBehavior": { "$ref": "#/$defs/nonEmpty" },
        "forbiddenBehavior": { "$ref": "#/$defs/nonEmpty" },
        "blocksCompletionWhenViolated": { "type": "boolean" },
        "linkedNegIds": { "$ref": "#/$defs/stringRefs" },
        "linkedEvidenceIds": { "$ref": "#/$defs/stringRefs" },
        "sequenceViewRefs": { "$ref": "#/$defs/stringRefs" },
        "requiredAssertions": { "$ref": "#/$defs/stringRefs" },
        "userVisibleOutcome": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "edgeCaseRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "category": { "$ref": "#/$defs/nonEmpty" },
        "condition": { "$ref": "#/$defs/nonEmpty" },
        "expectedBehavior": { "$ref": "#/$defs/nonEmpty" },
        "forbiddenBehavior": { "$ref": "#/$defs/nonEmpty" },
        "linkedFailurePathIds": { "$ref": "#/$defs/stringRefs" },
        "linkedEvidenceIds": { "$ref": "#/$defs/stringRefs" },
        "blocksImplementation": { "type": "boolean" }
      }
    },
    "acceptanceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suiteType",
        "file",
        "covers",
        "traceRows",
        "evidenceRefs",
        "commandRefs",
        "oracle",
        "mockOnly"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "suiteType": {
          "enum": ["unit", "integration", "acceptance", "contract", "e2e"]
        },
        "file": { "$ref": "#/$defs/nonEmpty" },
        "covers": { "$ref": "#/$defs/stringRefs" },
        "traceRows": { "$ref": "#/$defs/stringRefs" },
        "evidenceRefs": { "$ref": "#/$defs/stringRefs" },
        "commandRefs": { "$ref": "#/$defs/stringRefs" },
        "oracle": { "$ref": "#/$defs/nonEmpty" },
        "positiveControl": { "$ref": "#/$defs/nonEmpty" },
        "mockOnly": { "type": "boolean" }
      }
    },
    "e2eRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suiteType",
        "file",
        "covers",
        "traceRows",
        "evidenceRefs",
        "failurePathRefs",
        "edgeCaseRefs",
        "commandRefs",
        "oracle",
        "mockOnly"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "suiteType": { "const": "e2e" },
        "file": { "$ref": "#/$defs/nonEmpty" },
        "covers": { "$ref": "#/$defs/stringRefs" },
        "traceRows": { "$ref": "#/$defs/stringRefs" },
        "evidenceRefs": { "$ref": "#/$defs/stringRefs" },
        "failurePathRefs": { "$ref": "#/$defs/stringRefs" },
        "edgeCaseRefs": { "$ref": "#/$defs/stringRefs" },
        "commandRefs": { "$ref": "#/$defs/stringRefs" },
        "oracle": { "$ref": "#/$defs/nonEmpty" },
        "mockOnly": { "type": "boolean" }
      }
    },
    "traceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "covers",
        "taskRefs",
        "evidenceRefs",
        "acceptanceRefs",
        "contractValidationCommandRefs",
        "deliveryEvidenceCommandRefs",
        "status",
        "blockingReason"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "covers": { "$ref": "#/$defs/stringRefs" },
        "taskRefs": { "$ref": "#/$defs/stringRefs" },
        "evidenceRefs": { "$ref": "#/$defs/stringRefs" },
        "acceptanceRefs": { "$ref": "#/$defs/stringRefs" },
        "contractValidationCommandRefs": { "$ref": "#/$defs/stringRefs" },
        "deliveryEvidenceCommandRefs": { "$ref": "#/$defs/stringRefs" },
        "sequenceViewRefs": { "$ref": "#/$defs/stringRefs" },
        "flowViewRefs": { "$ref": "#/$defs/stringRefs" },
        "artifactRefs": { "$ref": "#/$defs/stringRefs" },
        "closureAssertion": { "$ref": "#/$defs/nonEmpty" },
        "targetStateAssertion": { "$ref": "#/$defs/nonEmpty" },
        "acceptanceSummary": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["PENDING", "PASS", "BLOCKED", "STALE"] },
        "blockingReason": { "$ref": "#/$defs/nullableNonEmpty" }
      }
    },
    "viewRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "visualKind": { "$ref": "#/$defs/nonEmpty" },
        "scope": { "$ref": "#/$defs/nonEmpty" },
        "covers": { "$ref": "#/$defs/stringRefs" },
        "traceRows": { "$ref": "#/$defs/stringRefs" },
        "evidenceRefs": { "$ref": "#/$defs/stringRefs" },
        "acceptanceRefs": { "$ref": "#/$defs/stringRefs" },
        "mermaid": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "edgeCaseViewRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "visualKind": { "$ref": "#/$defs/nonEmpty" },
        "scope": { "$ref": "#/$defs/nonEmpty" },
        "covers": { "$ref": "#/$defs/stringRefs" },
        "traceRows": { "$ref": "#/$defs/stringRefs" },
        "evidenceRefs": { "$ref": "#/$defs/stringRefs" },
        "acceptanceRefs": { "$ref": "#/$defs/stringRefs" },
        "failurePathRefs": { "$ref": "#/$defs/stringRefs" },
        "edgeCaseRefs": { "$ref": "#/$defs/stringRefs" },
        "cases": { "$ref": "#/$defs/stringRefs" },
        "mermaid": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "targetRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "coverageRole",
        "changeType",
        "intent",
        "ownerModel",
        "requirementRefs",
        "traceRefs",
        "evidenceRefs",
        "artifactRefs",
        "requiresReconfirmationOnChange"
      ],

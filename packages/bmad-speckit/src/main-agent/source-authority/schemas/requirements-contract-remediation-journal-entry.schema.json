{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "transactionManifestHash",
    "entryOrdinal",
    "eventType",
    "unitId",
    "previousEntryHash",
    "payloadHash",
    "decision",
    "entryHash"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-remediation-journal-entry/v1" },
    "transactionManifestHash": { "$ref": "#/$defs/hash" },
    "entryOrdinal": { "type": "integer", "minimum": 0 },
    "eventType": {
      "enum": ["prepare", "apply", "verify", "rollback", "seal", "recovery"]
    },
    "unitId": { "type": "string", "minLength": 1 },
    "previousEntryHash": { "$ref": "#/$defs/hash" },
    "payloadHash": { "$ref": "#/$defs/hash" },
    "decision": { "const": "pass" },
    "entryHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}

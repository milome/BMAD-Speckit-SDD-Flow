{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-runtime-security-parity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "phaseAuditAttemptId",
    "providerRef",
    "model",
    "credentialValueEmissionCount",
    "environmentOverrideCount",
    "endpointOverrideCount",
    "fallbackProviderCount",
    "operationPathOwner",
    "allowPassAuthority",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-judge-runtime-security-parity/v1" },
    "phase": { "enum": ["pre-candidate", "final"] },
    "phaseAuditAttemptId": { "type": "string", "minLength": 1 },
    "providerRef": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "credentialValueEmissionCount": { "const": 0 },
    "environmentOverrideCount": { "const": 0 },
    "endpointOverrideCount": { "const": 0 },
    "fallbackProviderCount": { "const": 0 },
    "operationPathOwner": { "const": "transport_adapter" },
    "allowPassAuthority": { "const": false },
    "decision": { "const": "pass" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "requirements-contract-active-authoring-attempt-pointer.schema.json",
  "title": "ActiveAuthoringAttemptPointer/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "authoringAttemptId", "attemptManifestPath", "attemptManifestHash", "latestValidPredecessorCheckpoint", "inputManifestHash"],
  "properties": {
    "schemaVersion": { "const": "ActiveAuthoringAttemptPointer/v1" },
    "authoringAttemptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "attemptManifestPath": { "type": "string", "pattern": "^authoring/staging/[A-Za-z0-9][A-Za-z0-9._-]*/manifests/[0-9]+-[A-Za-z0-9._-]+\\.json$" },
    "attemptManifestHash": { "$ref": "#/$defs/hash" },
    "latestValidPredecessorCheckpoint": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "inputManifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}

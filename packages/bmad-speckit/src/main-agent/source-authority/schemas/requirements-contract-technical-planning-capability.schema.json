{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-technical-planning-capability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authoringRequestId",
    "authoringAttemptId",
    "checkpointId",
    "capabilityId",
    "capabilityStatus",
    "capabilityHash",
    "configHash",
    "premiseHash",
    "triggerIdentity",
    "status",
    "issueCode",
    "resumable",
    "executionRegistry",
    "resultHash"
  ],
  "properties": {
    "schemaVersion": { "enum": ["requirements-contract-technical-planning-capability/v1", "requirements-contract-technical-planning-capability/v2"] },
    "authoringRequestId": { "$ref": "#/$defs/nonEmpty" },
    "authoringAttemptId": { "$ref": "#/$defs/nonEmpty" },
    "checkpointId": { "enum": ["cp02", "g02"] },
    "capabilityId": { "$ref": "#/$defs/nonEmpty" },
    "capabilityStatus": { "enum": ["available", "unavailable"] },
    "capabilityHash": { "$ref": "#/$defs/hash" },
    "configHash": { "$ref": "#/$defs/hash" },
    "premiseHash": { "$ref": "#/$defs/hash" },
    "triggerIdentity": { "$ref": "#/$defs/hash" },
    "status": { "enum": ["resolved", "technical_planning_pending"] },
    "issueCode": {
      "oneOf": [
        { "const": "requirements_technical_planning_pending" },
        { "type": "null" }
      ]
    },
    "resumable": { "type": "boolean" },
    "executionRegistry": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/executionRegistry" }
      ]
    },
    "resultHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": "requirements-contract-technical-planning-capability/v2" } } },
    "then": { "properties": { "executionRegistry": { "properties": { "schemaVersion": { "const": "requirements-contract-typed-execution-registry/v2" } } } } },
    "else": { "properties": { "executionRegistry": { "properties": { "schemaVersion": { "const": "requirements-contract-typed-execution-registry/v1" } } } } }
  }],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "value"],
      "properties": {
        "kind": { "enum": ["ART", "CMD", "CTM", "EVDREQ", "PATH", "STOP"] },
        "id": { "$ref": "#/$defs/nonEmpty" },
        "value": { "$ref": "#/$defs/nonEmpty" },
        "authorityKind": { "enum": ["source_declared", "derived"] },
        "applicableSourceRefs": { "$ref": "#/$defs/refs" },
        "premiseRefs": { "$ref": "#/$defs/refs" },
        "derivationReceiptRefs": { "$ref": "#/$defs/refs" },
        "sourceDeclarationRefs": { "$ref": "#/$defs/refs" },
        "conditions": { "type": "array" },
        "scope": { "type": "object" },
        "modality": { "enum": ["required", "suggested", "prohibited", "template", "context"] },
        "coverageRole": { "enum": ["action_trace", "non_action_declaration"] },
        "declarationRole": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "executionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "entries", "registryHash"],
      "properties": {
        "schemaVersion": { "enum": ["requirements-contract-typed-execution-registry/v1", "requirements-contract-typed-execution-registry/v2"] },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "registryHash": { "$ref": "#/$defs/hash" }
      },
      "allOf": [{
        "if": { "properties": { "schemaVersion": { "const": "requirements-contract-typed-execution-registry/v2" } } },
        "then": { "properties": { "entries": { "items": { "required": ["authorityKind", "applicableSourceRefs", "premiseRefs", "derivationReceiptRefs", "conditions", "scope"] } } } },
        "else": { "properties": { "entries": { "items": { "not": { "anyOf": [{ "required": ["authorityKind"] }, { "required": ["applicableSourceRefs"] }, { "required": ["premiseRefs"] }, { "required": ["derivationReceiptRefs"] }, { "required": ["conditions"] }, { "required": ["scope"] }, { "required": ["modality"] }, { "required": ["sourceDeclarationRefs"] }, { "required": ["coverageRole"] }, { "required": ["declarationRole"] }] } } } } }
      }]
    }
  }
}

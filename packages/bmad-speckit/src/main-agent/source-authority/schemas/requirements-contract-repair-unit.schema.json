{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "unitId",
    "originIds",
    "dependencyUnitIds",
    "conflictUnitIds",
    "rootCauseRef",
    "semanticRegionRef",
    "rollbackBoundaryRef",
    "postconditionRef",
    "atomicGroupId",
    "authorizedPaths",
    "preconditionHashes",
    "closurePredicates",
    "verificationRefs",
    "modelSuggestionRefs",
    "selfHash"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-repair-unit/v1" },
    "unitId": { "type": "string", "minLength": 1 },
    "originIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" } },
    "dependencyUnitIds": { "type": "array", "items": { "type": "string" } },
    "conflictUnitIds": { "type": "array", "items": { "type": "string" } },
    "rootCauseRef": { "type": "string", "minLength": 1 },
    "semanticRegionRef": { "type": "string", "minLength": 1 },
    "rollbackBoundaryRef": { "type": "string", "minLength": 1 },
    "postconditionRef": { "type": "string", "minLength": 1 },
    "atomicGroupId": { "$ref": "#/$defs/hash" },
    "authorizedPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "preconditionHashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" } },
    "closurePredicates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verificationRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "modelSuggestionRefs": { "type": "array", "items": { "type": "string" } },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-remediation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actorClass",
    "judgeRole",
    "ledgerNamespace",
    "batchId",
    "attemptKeyHash",
    "scopeManifestHash",
    "requirementsAuditAggregateHash",
    "auditUnitSetHash",
    "previousLedgerEntryHash",
    "authorityBindingHash",
    "gapCount",
    "validatedGapRefs",
    "remediationEntries",
    "priorFindingRefs",
    "currentDispositionRefs",
    "remediationBatchHash",
    "perGapModelInvocationCount",
    "readonlyAuditorInvocationCount",
    "writeSemantics",
    "writer",
    "decisionFieldOrigin",
    "decision",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-judge-remediation-receipt/v1" },
    "actorClass": { "const": "requirements_critical_auditor_judge" },
    "judgeRole": { "const": "requirements_critical_auditor" },
    "ledgerNamespace": { "const": "requirements" },
    "batchId": { "type": "string", "minLength": 1 },
    "attemptKeyHash": { "$ref": "#/$defs/hash" },
    "scopeManifestHash": { "$ref": "#/$defs/hash" },
    "requirementsAuditAggregateHash": { "$ref": "#/$defs/hash" },
    "auditUnitSetHash": { "$ref": "#/$defs/hash" },
    "previousLedgerEntryHash": {
      "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "authorityBindingHash": { "$ref": "#/$defs/hash" },
    "gapCount": { "type": "integer", "minimum": 0 },
    "validatedGapRefs": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "remediationEntries": {
      "type": "array",
      "items": { "$ref": "#/$defs/remediationEntry" }
    },
    "priorFindingRefs": { "$ref": "#/$defs/uniqueStrings" },
    "currentDispositionRefs": { "$ref": "#/$defs/uniqueStrings" },
    "remediationBatchHash": { "$ref": "#/$defs/hash" },
    "perGapModelInvocationCount": { "const": 0 },
    "readonlyAuditorInvocationCount": { "const": 0 },
    "writeSemantics": { "const": "create_only" },
    "writer": { "const": "package_owned_requirements_remediation_store" },
    "decisionFieldOrigin": { "const": "package_calculated" },
    "decision": { "const": "recorded" },
    "receiptHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "uniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gapId",
        "auditUnitRef",
        "requirementRef",
        "sourceRef",
        "sourceHash",
        "evidenceRef"
      ],
      "properties": {
        "gapId": { "type": "string", "minLength": 1 },
        "auditUnitRef": { "type": "string", "minLength": 1 },
        "requirementRef": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gapId", "disposition", "dispositionReasonHash"],
      "properties": {
        "gapId": { "type": "string", "minLength": 1 },
        "disposition": {
          "enum": [
            "source_repair_required",
            "evidence_repair_required",
            "requirement_rewrite_required",
            "accepted_false_positive"
          ]
        },
        "dispositionReasonHash": { "$ref": "#/$defs/hash" }
      }
    },
    "sourceRepairAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gapId", "actionKind", "targetPath", "sourceRef", "repairActionHash"],
      "properties": {
        "gapId": { "type": "string", "minLength": 1 },
        "actionKind": {
          "enum": [
            "edit_source",
            "add_evidence",
            "update_requirement",
            "no_source_change_false_positive"
          ]
        },
        "targetPath": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "repairActionHash": { "$ref": "#/$defs/hash" }
      }
    },
    "remediationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "disposition", "sourceRepairAction", "entryHash"],
      "properties": {
        "origin": { "$ref": "#/$defs/origin" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "sourceRepairAction": { "$ref": "#/$defs/sourceRepairAction" },
        "entryHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-projection-registry.schema.json",
  "title": "Requirements Contract Projection Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owner",
    "registryHash",
    "projections",
    "authority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-projection-registry/v1"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": {
          "const": "packages/bmad-speckit/src/main-agent/source-authority/rules/requirements-contract-projection-registry.ts"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "registryHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectionId",
          "canonicalPath",
          "canonicalHash",
          "surfacePaths",
          "surfaceHashes",
          "allowedDifferences",
          "authority"
        ],
        "properties": {
          "projectionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "canonicalPath": {
            "type": "string",
            "minLength": 1
          },
          "canonicalHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "surfacePaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "surfaceHashes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "allowedDifferences": {
            "type": "array",
            "maxItems": 0
          },
          "authority": {
            "const": "none"
          }
        }
      }
    },
    "authority": {
      "const": "none"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-credential-initialization-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicConfigHash",
    "canonicalPrivatePathHash",
    "credentialRevision",
    "providerRef",
    "authenticationType",
    "redactionDecision",
    "platformPermissionDecision",
    "targetPreexisted",
    "backupRef",
    "nonexistenceProofHash",
    "promotedHash",
    "readbackHash",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-judge-credential-initialization-receipt/v1"
    },
    "publicConfigHash": { "$ref": "#/$defs/hash" },
    "canonicalPrivatePathHash": { "$ref": "#/$defs/hash" },
    "credentialRevision": { "type": "integer", "minimum": 1 },
    "providerRef": { "type": "string", "minLength": 1 },
    "authenticationType": { "type": "string", "minLength": 1 },
    "redactionDecision": { "const": "pass" },
    "platformPermissionDecision": { "const": "pass" },
    "targetPreexisted": { "type": "boolean" },
    "backupRef": {
      "oneOf": [{ "$ref": "#/$defs/fileRef" }, { "type": "null" }]
    },
    "nonexistenceProofHash": {
      "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "promotedHash": { "$ref": "#/$defs/hash" },
    "readbackHash": { "$ref": "#/$defs/hash" },
    "decision": { "const": "pass" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-credentials.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "credentialRevision", "providers"],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-judge-credentials/v1" },
    "credentialRevision": { "type": "integer", "minimum": 1 },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authenticationType", "apiKey"],
        "properties": {
          "authenticationType": { "enum": ["bearer", "api_key"] },
          "apiKey": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-gap-closure-independent-audit-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gapId",
    "candidatePath",
    "candidateHash",
    "requirementRecordPath",
    "requirementRecordHash",
    "projectRoot",
    "freshnessRoot",
    "sourceSnapshotHash",
    "sourceDocumentHash",
    "semanticModelHash",
    "projectionSetHash",
    "productionEntry",
    "productionCallChain",
    "changedProductionFiles",
    "positiveCommand",
    "positiveRunId",
    "positiveLogPath",
    "positiveLogHash",
    "negativeCommands",
    "negativeRunIds",
    "negativeResults",
    "negativeLogPaths",
    "producerReceiptPaths",
    "producerReceiptHashes",
    "distHash",
    "packageHash",
    "cleanMaterializationReceiptPath",
    "cleanMaterializationReceiptHash",
    "auditorAdapterPath",
    "auditorAdapterHash",
    "actionBindingManifestPath",
    "actionBindingManifestHash",
    "canonicalAssetsManifestPath",
    "canonicalAssetsManifestHash",
    "criticalAuditorProfilePath",
    "criticalAuditorProfileHash",
    "criticalAuditorProfileDeclaredHash",
    "requestedAt",
    "requestHash"
  ],
  "properties": {
    "schemaVersion": { "const": "gap-closure-independent-audit-request/v1" },
    "gapId": { "type": "string", "minLength": 1 },
    "candidatePath": { "type": "string", "minLength": 1 },
    "candidateHash": { "$ref": "#/$defs/hash" },
    "requirementRecordPath": { "type": "string", "minLength": 1 },
    "requirementRecordHash": { "$ref": "#/$defs/hash" },
    "projectRoot": { "type": "string", "minLength": 1 },
    "freshnessRoot": { "type": "string", "minLength": 1 },
    "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
    "sourceDocumentHash": { "$ref": "#/$defs/hash" },
    "semanticModelHash": { "$ref": "#/$defs/hash" },
    "projectionSetHash": { "$ref": "#/$defs/hash" },
    "productionEntry": { "type": "string", "minLength": 1 },
    "productionCallChain": { "$ref": "#/$defs/nonEmptyStrings" },
    "changedProductionFiles": { "$ref": "#/$defs/nonEmptyStrings" },
    "positiveCommand": { "type": "string", "minLength": 1 },
    "positiveRunId": { "type": "string", "minLength": 1 },
    "positiveLogPath": { "type": "string", "minLength": 1 },
    "positiveLogHash": { "$ref": "#/$defs/hash" },
    "negativeCommands": { "$ref": "#/$defs/nonEmptyStrings" },
    "negativeRunIds": { "$ref": "#/$defs/nonEmptyStrings" },
    "negativeResults": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "negativeLogPaths": { "$ref": "#/$defs/nonEmptyStrings" },
    "producerReceiptPaths": { "$ref": "#/$defs/nonEmptyStrings" },
    "producerReceiptHashes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hash" }
    },
    "distHash": { "$ref": "#/$defs/hash" },
    "packageHash": { "$ref": "#/$defs/hash" },
    "cleanMaterializationReceiptPath": { "type": "string", "minLength": 1 },
    "cleanMaterializationReceiptHash": { "$ref": "#/$defs/hash" },
    "auditorAdapterPath": { "type": "string", "minLength": 1 },
    "auditorAdapterHash": { "$ref": "#/$defs/hash" },
    "actionBindingManifestPath": { "type": "string", "minLength": 1 },
    "actionBindingManifestHash": { "$ref": "#/$defs/hash" },
    "canonicalAssetsManifestPath": { "type": "string", "minLength": 1 },
    "canonicalAssetsManifestHash": { "$ref": "#/$defs/hash" },
    "criticalAuditorProfilePath": { "type": "string", "minLength": 1 },
    "criticalAuditorProfileHash": { "$ref": "#/$defs/hash" },
    "criticalAuditorProfileDeclaredHash": { "$ref": "#/$defs/hash" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "requestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

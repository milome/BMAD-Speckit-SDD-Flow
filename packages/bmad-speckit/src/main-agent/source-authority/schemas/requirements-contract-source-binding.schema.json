{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-source-binding.schema.json",
  "title": "Requirements Contract Source Binding Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordId", "semanticRevisionId", "scopeSemanticHash", "bindingRevisionId", "parentBindingRevisionId", "sourceBindingHash", "resolverIdentity", "sourceArtifacts", "sourceSpanRegistry", "sourceSpanRegistryHash", "evidenceClaimBindings", "evidenceClaimBindingRegistryHash"],
  "properties": {
    "schemaVersion": { "enum": ["requirements-contract-source-binding/v1", "requirements-contract-source-binding/v2"] },
    "recordId": { "$ref": "#/$defs/id" },
    "semanticRevisionId": { "$ref": "#/$defs/id" },
    "scopeSemanticHash": { "$ref": "#/$defs/hash" },
    "bindingRevisionId": { "type": "string", "pattern": "^BINDREV-[A-F0-9]{64}$" },
    "parentBindingRevisionId": { "oneOf": [{ "type": "string", "pattern": "^BINDREV-[A-F0-9]{64}$" }, { "type": "null" }] },
    "sourceBindingHash": { "$ref": "#/$defs/hash" },
    "resolverIdentity": { "$ref": "#/$defs/nonEmpty" },
    "sourceArtifacts": { "type": "array", "items": { "$ref": "#/$defs/sourceArtifact" } },
    "sourceSpanRegistry": { "type": "array", "items": { "$ref": "#/$defs/sourceSpan" } },
    "sourceSpanRegistryHash": { "$ref": "#/$defs/hash" },
    "evidenceClaimBindings": { "type": "array", "items": { "$ref": "#/$defs/claimBinding" } },
    "evidenceClaimBindingRegistryHash": { "$ref": "#/$defs/hash" },
    "typedSourceBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "graphHash", "mappings", "mappingsHash"],
      "properties": {
        "schemaVersion": { "const": "requirements-contract-typed-source-bindings/v2" },
        "graphHash": { "$ref": "#/$defs/hash" },
        "mappings": { "type": "object", "additionalProperties": true },
        "mappingsHash": { "$ref": "#/$defs/hash" }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": "requirements-contract-source-binding/v2" } } },
    "then": { "required": ["typedSourceBindings"] },
    "else": { "not": { "required": ["typedSourceBindings"] },
      "properties": { "evidenceClaimBindings": { "items": { "properties": { "authorityClass": { "const": "source_grounded" } } } } } }
  }],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "sourceArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceArtifactId", "role", "mediaType", "sourceSnapshotHash", "orderedPosition", "immutableBlobRef"],
      "properties": {
        "sourceArtifactId": { "$ref": "#/$defs/id" }, "role": { "$ref": "#/$defs/nonEmpty" },
        "mediaType": { "$ref": "#/$defs/nonEmpty" }, "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
        "orderedPosition": { "type": "integer", "minimum": 0 }, "immutableBlobRef": { "$ref": "#/$defs/path" }
      }
    },
    "sourceSpan": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSpanId", "sourceArtifactId", "sourceSnapshotHash", "startByte", "endByteExclusive", "startLine", "startColumn", "endLine", "endColumn", "exactTextHash", "normalizedTextHash", "structuralAnchor"],
      "properties": {
        "sourceSpanId": { "type": "string", "pattern": "^SOURCE-SPAN-[A-F0-9]{16,64}$" },
        "sourceArtifactId": { "$ref": "#/$defs/id" }, "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
        "startByte": { "type": "integer", "minimum": 0 }, "endByteExclusive": { "type": "integer", "minimum": 1 },
        "startLine": { "type": "integer", "minimum": 1 }, "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }, "endColumn": { "type": "integer", "minimum": 1 },
        "exactTextHash": { "$ref": "#/$defs/hash" }, "normalizedTextHash": { "$ref": "#/$defs/hash" },
        "structuralAnchor": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "claimBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceClaimId", "specSpanId", "authorityClass", "sourceSpanRefs"],
      "properties": {
        "evidenceClaimId": { "$ref": "#/$defs/id" },
        "specSpanId": { "type": "string", "pattern": "^SPEC-SPAN-[A-F0-9]{16,64}$" },
        "authorityClass": { "enum": ["source_grounded", "human_confirmed", "derived"] },
        "sourceSpanRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^SOURCE-SPAN-[A-F0-9]{16,64}$" } }
      },
      "allOf": [{
        "if": { "properties": { "authorityClass": { "const": "source_grounded" } } },
        "then": { "properties": { "sourceSpanRefs": { "minItems": 1 } } },
        "else": { "properties": { "sourceSpanRefs": { "maxItems": 0 } } }
      }]
    }
  }
}

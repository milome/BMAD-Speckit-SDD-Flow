{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-real-consumer-confirmation-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "transactionId",
    "implementationAttemptId",
    "phaseAuditAttemptId",
    "preConfirmationSnapshot",
    "boundaryObserverReceipt",
    "preConfirmationEvidenceSetHash",
    "preConfirmationStageSnapshotHash",
    "confirmed",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-real-consumer-confirmation-receipt/v1" },
    "phase": { "enum": ["pre-candidate", "final"] },
    "transactionId": { "type": "string", "minLength": 1 },
    "implementationAttemptId": { "type": "string", "minLength": 1 },
    "phaseAuditAttemptId": { "type": "string", "minLength": 1 },
    "preConfirmationSnapshot": { "$ref": "#/$defs/ref" },
    "boundaryObserverReceipt": { "$ref": "#/$defs/ref" },
    "preConfirmationEvidenceSetHash": { "$ref": "#/$defs/hash" },
    "preConfirmationStageSnapshotHash": { "$ref": "#/$defs/hash" },
    "confirmed": { "const": true },
    "decision": { "const": "PASS" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

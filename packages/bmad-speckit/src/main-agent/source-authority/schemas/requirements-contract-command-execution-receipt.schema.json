{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-command-execution-receipt.schema.json",
  "title": "Requirements Contract Command Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandRunId",
    "commandId",
    "command",
    "normalizedCommand",
    "argv",
    "argvHash",
    "cwd",
    "executorIdentity",
    "hostIdentity",
    "requirementSetId",
    "requirementRefs",
    "transactionId",
    "implementationAttemptId",
    "architectureAuditAttemptId",
    "activePhaseAuditAttemptId",
    "contractHash",
    "inputSnapshotHash",
    "startedAt",
    "endedAt",
    "exitCode",
    "signal",
    "stdoutPath",
    "stdoutHash",
    "stderrPath",
    "stderrHash",
    "acceptanceRefs",
    "traceRefs",
    "publication",
    "decision",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-command-execution-receipt/v1"
    },
    "commandRunId": {
      "type": "string",
      "pattern": "^RUN-[A-Za-z0-9._-]+$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^CMD-[A-Za-z0-9._-]+$"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "normalizedCommand": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "$ref": "#/$defs/argv"
    },
    "argvHash": {
      "$ref": "#/$defs/sha256"
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "executorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "id"],
      "properties": {
        "class": {
          "enum": [
            "controlled_detached_executor",
            "goal_controlled_executor"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hostIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "nodeVersion"],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "nodeVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirementSetId": {
      "type": "string",
      "minLength": 1
    },
    "requirementRefs": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "transactionId": {
      "type": "string",
      "pattern": "^TX-[A-Za-z0-9._-]+$"
    },
    "implementationAttemptId": {
      "type": "string",
      "pattern": "^IMPL-ATTEMPT-[A-Z0-9][A-Z0-9._-]*$"
    },
    "architectureAuditAttemptId": {
      "type": "string",
      "pattern": "^AUDIT-[A-Za-z0-9._-]+$"
    },
    "activePhaseAuditAttemptId": {
      "type": "string",
      "pattern": "^AUDIT-[A-Za-z0-9._-]+$"
    },
    "contractHash": {
      "$ref": "#/$defs/sha256"
    },
    "inputSnapshotHash": {
      "$ref": "#/$defs/sha256"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "exitCode": {
      "type": "integer"
    },
    "signal": {
      "type": ["string", "null"]
    },
    "stdoutPath": {
      "type": "string",
      "minLength": 1
    },
    "stdoutHash": {
      "$ref": "#/$defs/sha256"
    },
    "stderrPath": {
      "type": "string",
      "minLength": 1
    },
    "stderrHash": {
      "$ref": "#/$defs/sha256"
    },
    "acceptanceRefs": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "traceRefs": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer",
        "targetPath",
        "publishedAt",
        "readbackAt",
        "explicitUtf8",
        "createOnly",
        "readbackVerified"
      ],
      "properties": {
        "writer": {
          "type": "string",
          "minLength": 1
        },
        "targetPath": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "readbackAt": {
          "type": "string",
          "format": "date-time"
        },
        "explicitUtf8": {
          "const": true
        },
        "createOnly": {
          "const": true
        },
        "readbackVerified": {
          "const": true
        }
      }
    },
    "decision": {
      "enum": ["pass", "block"]
    },
    "receiptHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-business-behavior-delta.schema.json",
  "title": "Requirements Contract Business Behavior Delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requirementSetId",
    "semanticModelHash",
    "scenarios",
    "syntheticCurrentBehaviorCount",
    "decision",
    "deltaHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-business-behavior-delta/v1"
    },
    "requirementSetId": {
      "type": "string",
      "minLength": 1
    },
    "semanticModelHash": {
      "$ref": "#/$defs/sha256"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioId",
          "currentBehavior",
          "targetBehavior",
          "deltaType",
          "scenarioDeltaHash"
        ],
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^SCN-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
          },
          "currentBehavior": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "description", "proofRefs"],
                "properties": {
                  "status": {
                    "const": "proved"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "proofRefs": {
                    "$ref": "#/$defs/nonEmptyStringArray"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "proofRefs"],
                "properties": {
                  "status": {
                    "const": "unknown"
                  },
                  "proofRefs": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            ]
          },
          "targetBehavior": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "requirementRefs"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "requirementRefs": {
                "$ref": "#/$defs/nonEmptyStringArray"
              }
            }
          },
          "deltaType": {
            "enum": ["added", "modified", "unchanged"]
          },
          "scenarioDeltaHash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "syntheticCurrentBehaviorCount": {
      "type": "integer",
      "const": 0
    },
    "decision": {
      "const": "pass"
    },
    "deltaHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}

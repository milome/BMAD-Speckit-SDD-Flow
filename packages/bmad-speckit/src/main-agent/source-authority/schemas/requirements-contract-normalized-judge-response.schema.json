{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-normalized-judge-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerRef",
    "transport",
    "configuredModel",
    "returnedModel",
    "decision",
    "findings",
    "challengeRequests",
    "evidenceRefs",
    "providerRequestId",
    "requestHash",
    "responseHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-normalized-judge-response/v1"
    },
    "providerRef": { "type": "string", "minLength": 1 },
    "transport": {
      "enum": ["openai-compatible", "anthropic-compatible", "claude-code-cli"]
    },
    "configuredModel": { "type": ["string", "null"], "minLength": 1 },
    "returnedModel": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["pass", "block", "inconclusive"] },
    "findings": {
      "type": "array",
      "items": { "type": "object" }
    },
    "challengeRequests": {
      "type": "array",
      "items": { "type": "object" }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "providerRequestId": { "type": "string", "minLength": 1 },
    "requestHash": { "$ref": "#/$defs/hash" },
    "responseHash": { "$ref": "#/$defs/hash" },
    "transportEvidence": {
      "$ref": "#/$defs/claudeCodeCliTransportEvidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": { "const": "claude-code-cli" }
        }
      },
      "then": {
        "required": ["transportEvidence"]
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "claudeCodeCliTransportEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "argv",
        "cwd",
        "executorKind",
        "processId",
        "requestedModel",
        "initModel",
        "modelUsageModels",
        "credentialRevision",
        "credentialEnvironmentVariable",
        "sessionId",
        "exitCode",
        "stdoutPath",
        "stdoutHash",
        "stderrPath",
        "stderrHash",
        "transcriptPath",
        "transcriptHash",
        "structuredOutputSchemaHash",
        "snapshotManifestPath",
        "snapshotHash"
      ],
      "properties": {
        "schemaVersion": {
          "const": "requirements-contract-claude-code-cli-execution/v1"
        },
        "command": { "const": "claude" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "executorKind": {
          "enum": ["native_spawn", "injected_test_transport"]
        },
        "processId": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "requestedModel": { "type": ["string", "null"], "minLength": 1 },
        "initModel": { "type": ["string", "null"], "minLength": 1 },
        "modelUsageModels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "credentialRevision": { "type": "integer", "minimum": 1 },
        "credentialEnvironmentVariable": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "exitCode": { "const": 0 },
        "stdoutPath": { "type": "string", "minLength": 1 },
        "stdoutHash": { "$ref": "#/$defs/hash" },
        "stderrPath": { "type": "string", "minLength": 1 },
        "stderrHash": { "$ref": "#/$defs/hash" },
        "transcriptPath": { "type": "string", "minLength": 1 },
        "transcriptHash": { "$ref": "#/$defs/hash" },
        "structuredOutputSchemaHash": { "$ref": "#/$defs/hash" },
        "snapshotManifestPath": { "type": "string", "minLength": 1 },
        "snapshotHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

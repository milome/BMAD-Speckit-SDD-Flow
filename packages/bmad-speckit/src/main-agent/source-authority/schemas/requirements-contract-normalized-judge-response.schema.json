{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-normalized-judge-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerRef",
    "transport",
    "configuredModel",
    "returnedModel",
    "decision",
    "findings",
    "challengeRequests",
    "evidenceRefs",
    "providerRequestId",
    "requestHash",
    "responseHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-normalized-judge-response/v1"
    },
    "providerRef": { "type": "string", "minLength": 1 },
    "transport": {
      "enum": ["openai-compatible", "anthropic-compatible", "claude-code-cli", "cli"]
    },
    "configuredModel": { "type": ["string", "null"], "minLength": 1 },
    "returnedModel": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["pass", "block", "inconclusive"] },
    "findings": {
      "type": "array",
      "items": { "type": "object" }
    },
    "challengeRequests": {
      "type": "array",
      "items": { "type": "object" }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "providerRequestId": { "type": "string", "minLength": 1 },
    "requestHash": { "$ref": "#/$defs/hash" },
    "responseHash": { "$ref": "#/$defs/hash" },
    "transportEvidence": {
      "$ref": "#/$defs/cliJudgeExecutionReceipt"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "enum": ["claude-code-cli", "cli"]
          }
        }
      },
      "then": {
        "required": ["transportEvidence"]
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "cliJudgeExecutionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "adapterRef",
        "protocol",
        "command",
        "argv",
        "commandResolution",
        "launchCommand",
        "launchCommandHash",
        "launchArgv",
        "launchEntryPath",
        "launchEntryHash",
        "cwd",
        "executorKind",
        "processId",
        "providerRequestId",
        "requestedModel",
        "observedModel",
        "modelObservationSource",
        "decisionBearingModelEvidence",
        "credentialRevision",
        "credentialEnvironmentVariable",
        "runtimeHomePath",
        "runtimeConfigHash",
        "exitCode",
        "stdoutPath",
        "stdoutHash",
        "stderrPath",
        "stderrHash",
        "transcriptPath",
        "transcriptHash",
        "outputPath",
        "outputHash",
        "structuredOutputSchemaPath",
        "structuredOutputSchemaHash",
        "snapshotManifestPath",
        "snapshotHash",
        "sessionId",
        "initModel",
        "modelUsageModels"
      ],
      "properties": {
        "schemaVersion": {
          "const": "requirements-contract-cli-judge-execution-receipt/v1"
        },
        "adapterRef": { "type": "string", "minLength": 1 },
        "protocol": {
          "enum": ["claude_stream_json", "codex_exec_jsonl"]
        },
        "command": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "commandResolution": {
          "enum": [
            "path_search_executable",
            "windows_npm_shim",
            "process_spawn_path_search",
            "injected_test_transport"
          ]
        },
        "launchCommand": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "launchCommandHash": {
          "anyOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "launchArgv": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": { "type": "string" }
        },
        "launchEntryPath": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "launchEntryHash": {
          "anyOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "cwd": { "type": "string", "minLength": 1 },
        "executorKind": {
          "enum": ["native_spawn", "injected_test_transport"]
        },
        "processId": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "providerRequestId": { "type": "string", "minLength": 1 },
        "requestedModel": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "observedModel": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "modelObservationSource": {
          "enum": ["cli_event", "gateway_receipt", "configured_request", "unavailable"]
        },
        "decisionBearingModelEvidence": { "type": "boolean" },
        "credentialRevision": { "type": "integer", "minimum": 1 },
        "credentialEnvironmentVariable": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "runtimeHomePath": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "runtimeConfigHash": {
          "anyOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "exitCode": { "const": 0 },
        "stdoutPath": { "type": "string", "minLength": 1 },
        "stdoutHash": { "$ref": "#/$defs/hash" },
        "stderrPath": { "type": "string", "minLength": 1 },
        "stderrHash": { "$ref": "#/$defs/hash" },
        "transcriptPath": { "type": "string", "minLength": 1 },
        "transcriptHash": { "$ref": "#/$defs/hash" },
        "outputPath": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "outputHash": {
          "anyOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "structuredOutputSchemaPath": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "structuredOutputSchemaHash": { "$ref": "#/$defs/hash" },
        "snapshotManifestPath": { "type": "string", "minLength": 1 },
        "snapshotHash": { "$ref": "#/$defs/hash" },
        "sessionId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "initModel": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "modelUsageModels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "executorKind": { "const": "injected_test_transport" }
            },
            "required": ["executorKind"]
          },
          "then": {
            "properties": {
              "commandResolution": { "const": "injected_test_transport" },
              "launchCommand": { "type": "null" },
              "launchCommandHash": { "type": "null" },
              "launchArgv": { "type": "null" },
              "launchEntryPath": { "type": "null" },
              "launchEntryHash": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "commandResolution": {
                "enum": [
                  "path_search_executable",
                  "windows_npm_shim",
                  "process_spawn_path_search"
                ]
              },
              "launchCommand": { "type": "string", "minLength": 1 },
              "launchCommandHash": { "$ref": "#/$defs/hash" },
              "launchArgv": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "commandResolution": { "const": "windows_npm_shim" }
            },
            "required": ["commandResolution"]
          },
          "then": {
            "properties": {
              "launchEntryPath": { "type": "string", "minLength": 1 },
              "launchEntryHash": { "$ref": "#/$defs/hash" }
            }
          },
          "else": {
            "properties": {
              "launchEntryPath": { "type": "null" },
              "launchEntryHash": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decisionBearingModelEvidence": { "const": true }
            },
            "required": ["decisionBearingModelEvidence"]
          },
          "then": {
            "properties": {
              "observedModel": { "type": "string", "minLength": 1 },
              "modelObservationSource": {
                "enum": ["cli_event", "gateway_receipt"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": { "const": "codex_exec_jsonl" }
            },
            "required": ["protocol"]
          },
          "then": {
            "properties": {
              "adapterRef": { "const": "CodexCliJudgeAdapter" },
              "runtimeHomePath": { "type": "string", "minLength": 1 },
              "runtimeConfigHash": { "$ref": "#/$defs/hash" },
              "outputPath": { "type": "string", "minLength": 1 },
              "outputHash": { "$ref": "#/$defs/hash" },
              "structuredOutputSchemaPath": { "type": "string", "minLength": 1 },
              "sessionId": { "type": "null" },
              "initModel": { "type": "null" },
              "modelUsageModels": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "adapterRef": { "const": "ClaudeCodeCliJudgeAdapter" },
              "runtimeHomePath": { "type": "null" },
              "runtimeConfigHash": { "type": "null" },
              "outputPath": { "type": "null" },
              "outputHash": { "type": "null" },
              "structuredOutputSchemaPath": { "type": "null" },
              "sessionId": { "type": "string", "minLength": 1 },
              "modelUsageModels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    }
  }
}

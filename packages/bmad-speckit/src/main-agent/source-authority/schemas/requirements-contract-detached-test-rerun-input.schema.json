{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-detached-test-rerun-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "changedPathManifest",
    "baseline",
    "commandRange",
    "workspaceMode",
    "artifactRoot",
    "out"
  ],
  "properties": {
    "cwd": { "type": "string", "minLength": 1 },
    "contract": { "type": "string", "minLength": 1 },
    "changedPathManifest": { "type": "string", "minLength": 1 },
    "baseline": { "type": "string", "minLength": 1 },
    "commandRange": {
      "type": "string",
      "pattern": "^CMD-[0-9]{2}:CMD-[0-9]{2}$"
    },
    "workspaceMode": { "const": "isolated-snapshot" },
    "artifactRoot": { "type": "string", "minLength": 1 },
    "out": { "type": "string", "minLength": 1 },
    "json": { "type": "boolean" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-evidence-artifact-readback-receipt.schema.json",
  "title": "Requirements Contract Evidence Artifact Readback Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "artifactType",
    "artifactPath",
    "artifactHash",
    "artifactSchemaPath",
    "artifactSchemaHash",
    "producerIdentity",
    "requirementSetId",
    "requirementRefs",
    "transactionId",
    "implementationAttemptId",
    "publishedAt",
    "readbackAt",
    "publication",
    "decision",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-evidence-artifact-readback-receipt/v1"
    },
    "artifactId": { "type": "string", "minLength": 1 },
    "artifactType": { "type": "string", "minLength": 1 },
    "artifactPath": { "type": "string", "minLength": 1 },
    "artifactHash": { "$ref": "#/$defs/sha256" },
    "artifactSchemaPath": { "type": "string", "minLength": 1 },
    "artifactSchemaHash": { "$ref": "#/$defs/sha256" },
    "producerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "id"],
      "properties": {
        "class": {
          "enum": ["controlled_artifact_producer", "goal_controlled_executor"]
        },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "requirementSetId": { "type": "string", "minLength": 1 },
    "requirementRefs": { "$ref": "#/$defs/nonEmptyStrings" },
    "transactionId": {
      "type": "string",
      "pattern": "^TX-[A-Za-z0-9._-]+$"
    },
    "implementationAttemptId": {
      "type": "string",
      "pattern": "^IMP-[A-Za-z0-9._-]+$"
    },
    "publishedAt": { "type": "string", "format": "date-time" },
    "readbackAt": { "type": "string", "format": "date-time" },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetPath",
        "publishedHash",
        "readbackHash",
        "readbackVerified"
      ],
      "properties": {
        "targetPath": { "type": "string", "minLength": 1 },
        "publishedHash": { "$ref": "#/$defs/sha256" },
        "readbackHash": { "$ref": "#/$defs/sha256" },
        "readbackVerified": { "const": true }
      }
    },
    "decision": { "enum": ["pass", "block"] },
    "receiptHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}

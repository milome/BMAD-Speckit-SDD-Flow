{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-remediation-publication-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "candidateId",
    "postRemediationAttemptKey",
    "publicationOrdinal",
    "publishedPathHashes",
    "dirtyPreservationHash",
    "markdownAuthorityPublished",
    "recoveredFromPartialPromotion",
    "decision",
    "publicationReceiptHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-remediation-publication-receipt/v1"
    },
    "campaignId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "postRemediationAttemptKey": { "$ref": "#/$defs/sha256" },
    "publicationOrdinal": {
      "type": "integer",
      "const": 1
    },
    "publishedPathHashes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "dirtyPreservationHash": { "$ref": "#/$defs/sha256" },
    "markdownAuthorityPublished": { "const": false },
    "recoveredFromPartialPromotion": { "type": "boolean" },
    "decision": { "const": "pass" },
    "publicationReceiptHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

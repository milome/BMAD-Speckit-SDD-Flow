{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "phaseAuditAttemptId",
    "requestHash",
    "responseHash",
    "decision",
    "findings",
    "challengeRequests",
    "allowPassAuthority",
    "writeSequence"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-judge-response/v1" },
    "phase": { "enum": ["pre-candidate", "final"] },
    "phaseAuditAttemptId": { "type": "string", "minLength": 1 },
    "requestHash": { "$ref": "#/$defs/hash" },
    "responseHash": { "$ref": "#/$defs/hash" },
    "decision": { "enum": ["pass", "block", "inconclusive"] },
    "findings": { "type": "array", "items": { "type": "object" } },
    "challengeRequests": { "type": "array", "items": { "type": "object" } },
    "allowPassAuthority": { "const": false },
    "writeSequence": { "enum": [1, 3] }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

  "$id": "requirements-contract-bundle-publish-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirementRecord", "sourceDocument", "receipt"],
  "properties": {
    "cwd": { "type": "string", "minLength": 1 },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirement-contract-model-v2.schema.json",
  "title": "Requirement Contract Model v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activationState",
    "recordId",
    "requirementSetId",
    "requirements",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirement-contract-model/v2"
    },
    "activationState": {
      "const": "inactive_schema_boundary"
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "requirementSetId": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "endLine"],
      "properties": {
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sourceSpan", "sourceHash", "sourceRequirementId", "headingPath"],
      "properties": {
        "sourcePath": {
          "$ref": "#/$defs/nullableString"
        },
        "sourceSpan": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceHash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRequirementId": {
          "$ref": "#/$defs/nullableString"
        },
        "headingPath": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "trigger",
        "preconditions",
        "action",
        "postconditions",
        "invariants",
        "thresholds"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/nullableString"
        },
        "trigger": {
          "$ref": "#/$defs/nullableString"
        },
        "preconditions": {
          "$ref": "#/$defs/stringArray"
        },
        "action": {
          "$ref": "#/$defs/nullableString"
        },
        "postconditions": {
          "$ref": "#/$defs/stringArray"
        },
        "invariants": {
          "$ref": "#/$defs/stringArray"
        },
        "thresholds": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityState", "derivation", "decisionReceiptRef"],
      "properties": {
        "authorityState": {
          "enum": ["source_grounded", "human_confirmed", "derived", "unresolved", "invalid"]
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "decisionReceiptRef": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCode"],
      "properties": {
        "state": {
          "enum": ["applicable", "not_applicable", "unresolved", "invalid"]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "question", "blocking"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "oracleRef", "commandRefs", "expectedObservationRefs"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "oracleRef": {
          "$ref": "#/$defs/nullableString"
        },
        "commandRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "expectedObservationRefs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRefs", "artifactRefs", "traceEdgeRefs"],
      "properties": {
        "targetRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "artifactRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "traceEdgeRefs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "schemaVersion",
        "text",
        "source",
        "semantics",
        "authority",
        "applicability",
        "unresolved",
        "verification",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:MUST-(?:FR|NFR)-[0-9]{3}|NEG-[0-9]{3}|OUT-[0-9]{3})$"
        },
        "kind": {
          "enum": ["functional", "nonfunctional", "negative", "out_of_scope"]
        },
        "schemaVersion": {
          "const": "requirement-contract-requirement/v2"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "semantics": {
          "$ref": "#/$defs/semantics"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolvedItem"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "fromRef", "toRef"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "fromRef": {
          "type": "string",
          "minLength": 1
        },
        "toRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-candidate-package-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hashDomainRegistry",
    "packageManifestRef",
    "packageVersion",
    "sourceManifestHash",
    "generatedDistManifestHash",
    "runtimeAssetManifestRef",
    "buildAuthorityReceiptRef",
    "distBuildHash",
    "nodeVersion",
    "nodeExecutableRef",
    "npmVersion",
    "npmExecutableRef",
    "packArgv",
    "packCwd",
    "originalTarballRef",
    "canonicalTarballRef",
    "packedEntries",
    "packedEntrySetHash",
    "forbiddenPackedSourceSnapshotCount",
    "packedRuntimeHash",
    "packedRuntimeFileCount",
    "phaseIdentity",
    "publicationHash",
    "tarballBytesHash",
    "readbackHash",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-candidate-package-receipt/v2" },
    "hashDomainRegistry": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "const": "requirements-contract-hash-domains/v2" }
      }
    },
    "packageManifestRef": { "$ref": "#/$defs/fileRef" },
    "packageVersion": { "type": "string", "minLength": 1 },
    "sourceManifestHash": { "$ref": "#/$defs/hash" },
    "generatedDistManifestHash": { "$ref": "#/$defs/hash" },
    "runtimeAssetManifestRef": { "$ref": "#/$defs/fileRef" },
    "buildAuthorityReceiptRef": { "$ref": "#/$defs/fileRef" },
    "distBuildHash": { "$ref": "#/$defs/hash" },
    "nodeVersion": { "const": "v22.22.1" },
    "nodeExecutableRef": { "$ref": "#/$defs/fileRef" },
    "npmVersion": { "const": "10.9.4" },
    "npmExecutableRef": { "$ref": "#/$defs/fileRef" },
    "packArgv": {
      "type": "array",
      "prefixItems": [
        { "enum": ["npm", "npm.cmd"] },
        { "const": "pack" },
        { "const": "--json" },
        { "const": "--ignore-scripts" }
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": false
    },
    "packCwd": { "type": "string", "minLength": 1 },
    "originalTarballRef": { "$ref": "#/$defs/fileRef" },
    "canonicalTarballRef": { "$ref": "#/$defs/fileRef" },
    "packedEntries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "packedEntrySetHash": { "$ref": "#/$defs/hash" },
    "forbiddenPackedSourceSnapshotCount": { "const": 0 },
    "packedRuntimeHash": { "$ref": "#/$defs/hash" },
    "packedRuntimeFileCount": { "type": "integer", "minimum": 1 },
    "phaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "implementationAttemptId",
        "phase",
        "phaseAuditAttemptId"
      ],
      "properties": {
        "transactionId": { "type": "string", "minLength": 1 },
        "implementationAttemptId": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["architecture", "pre-candidate", "final"] },
        "phaseAuditAttemptId": { "type": "string", "minLength": 1 }
      }
    },
    "publicationHash": { "$ref": "#/$defs/hash" },
    "tarballBytesHash": { "$ref": "#/$defs/hash" },
    "readbackHash": { "$ref": "#/$defs/hash" },
    "decision": { "const": "pass" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

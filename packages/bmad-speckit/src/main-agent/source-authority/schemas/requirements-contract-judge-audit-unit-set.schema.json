{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad-speckit.local/schemas/requirements-contract-judge-audit-unit-set.schema.json",
  "title": "Requirements Contract Judge Audit Unit Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "requirementSetId",
    "sourceAuthorityHash",
    "semanticModelHash",
    "canonicalTraceGraphHash",
    "canonicalRootUniverse",
    "judgeAuditUniverseHash",
    "judgeAuditUnitSetHash",
    "rootUniverse",
    "rootToUnit",
    "unitToRoot",
    "units",
    "coverage",
    "blockingReasons",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-judge-audit-unit-set/v1" },
    "authority": { "const": "none" },
    "requirementSetId": { "$ref": "#/$defs/nonEmptyString" },
    "sourceAuthorityHash": { "$ref": "#/$defs/hash" },
    "semanticModelHash": { "$ref": "#/$defs/hash" },
    "canonicalTraceGraphHash": { "$ref": "#/$defs/hash" },
    "canonicalRootUniverse": { "$ref": "#/$defs/canonicalRootUniverse" },
    "judgeAuditUniverseHash": { "$ref": "#/$defs/hash" },
    "judgeAuditUnitSetHash": { "$ref": "#/$defs/hash" },
    "rootUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementRootRefs", "negativeRootRefs", "acceptanceRootRefs", "allRootRefs"],
      "properties": {
        "requirementRootRefs": { "$ref": "#/$defs/refArray" },
        "negativeRootRefs": { "$ref": "#/$defs/refArray" },
        "acceptanceRootRefs": { "$ref": "#/$defs/refArray" },
        "allRootRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "rootToUnit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rootRef", "unitId"],
        "properties": {
          "rootRef": { "$ref": "#/$defs/ref" },
          "unitId": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "uniqueItems": true
    },
    "unitToRoot": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "rootRefs"],
        "properties": {
          "unitId": { "$ref": "#/$defs/nonEmptyString" },
          "rootRefs": { "$ref": "#/$defs/refArray" }
        }
      },
      "uniqueItems": true
    },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/unit" },
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicableRootCount",
        "unitCount",
        "mustUnitCount",
        "standaloneUnitCount",
        "missingRootCount",
        "extraRootCount",
        "orphanRootCount",
        "duplicateRootCount",
        "missingRootBindingCount",
        "rootPayloadMismatchCount",
        "semanticRootMismatchCount",
        "acceptanceRootMismatchCount",
        "invalidAssociationEdgeCount",
        "unitEvidenceCompleteness",
        "mustUnitCoverage",
        "negativeRootCoverage",
        "acceptanceRootCoverage"
      ],
      "properties": {
        "applicableRootCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "unitCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "mustUnitCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "standaloneUnitCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "missingRootCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "extraRootCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "orphanRootCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "duplicateRootCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "missingRootBindingCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "rootPayloadMismatchCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "semanticRootMismatchCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "acceptanceRootMismatchCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "invalidAssociationEdgeCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "unitEvidenceCompleteness": { "enum": [0, 1] },
        "mustUnitCoverage": { "enum": [0, 1] },
        "negativeRootCoverage": { "enum": [0, 1] },
        "acceptanceRootCoverage": { "enum": [0, 1] }
      }
    },
    "blockingReasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "decision": { "enum": ["pass", "block"] }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "refArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" },
      "uniqueItems": true
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "canonicalRootUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticConservationManifestHash",
        "acceptanceRootProofManifestHash",
        "requirementRoots",
        "acceptanceRoots"
      ],
      "properties": {
        "semanticConservationManifestHash": { "$ref": "#/$defs/hash" },
        "acceptanceRootProofManifestHash": { "$ref": "#/$defs/hash" },
        "requirementRoots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/canonicalRequirementRoot" },
          "uniqueItems": true
        },
        "acceptanceRoots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/canonicalAcceptanceRoot" },
          "uniqueItems": true
        }
      }
    },
    "canonicalRequirementRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootRef",
        "requirementKind",
        "payloadHash",
        "sourceSpanRefs",
        "applicability",
        "authorityProofRefs"
      ],
      "properties": {
        "rootRef": { "$ref": "#/$defs/ref" },
        "requirementKind": {
          "enum": ["functional", "nonfunctional", "negative"]
        },
        "payloadHash": { "$ref": "#/$defs/hash" },
        "sourceSpanRefs": { "$ref": "#/$defs/refArray" },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "reasonCode", "proofRefs"],
          "properties": {
            "decision": {
              "enum": ["applicable", "not_applicable", "unresolved", "invalid"]
            },
            "reasonCode": { "$ref": "#/$defs/nonEmptyString" },
            "proofRefs": { "$ref": "#/$defs/refArray" }
          }
        },
        "authorityProofRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "canonicalAcceptanceRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootRef",
        "payloadHash",
        "sourceSpanRefs",
        "requirementRefs",
        "applicability",
        "authorityProofRefs"
      ],
      "properties": {
        "rootRef": { "$ref": "#/$defs/ref" },
        "payloadHash": { "$ref": "#/$defs/hash" },
        "sourceSpanRefs": { "$ref": "#/$defs/refArray" },
        "requirementRefs": { "$ref": "#/$defs/refArray" },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "reasonCode", "proofRefs"],
          "properties": {
            "decision": {
              "enum": ["applicable", "not_applicable", "unresolved", "invalid"]
            },
            "reasonCode": { "$ref": "#/$defs/nonEmptyString" },
            "proofRefs": { "$ref": "#/$defs/refArray" }
          }
        },
        "authorityProofRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "unitKind",
        "requirementRef",
        "rootRefs",
        "sourceSpanRefs",
        "traceRowRefs",
        "targetRefs",
        "sequenceStepRefs",
        "redRefs",
        "oracleRefs",
        "changedPathRefs",
        "commandRefs",
        "evidenceRefs",
        "testRefs",
        "fixtureRefs",
        "assertionRefs",
        "observedSequenceRefs",
        "deterministicReportRefs",
        "proofRefs",
        "unitHash"
      ],
      "properties": {
        "unitId": { "$ref": "#/$defs/nonEmptyString" },
        "unitKind": { "enum": ["must", "standalone"] },
        "requirementRef": { "$ref": "#/$defs/ref" },
        "rootRefs": { "$ref": "#/$defs/refArray" },
        "sourceSpanRefs": { "$ref": "#/$defs/refArray" },
        "traceRowRefs": { "$ref": "#/$defs/refArray" },
        "targetRefs": { "$ref": "#/$defs/refArray" },
        "sequenceStepRefs": { "$ref": "#/$defs/refArray" },
        "redRefs": { "$ref": "#/$defs/refArray" },
        "oracleRefs": { "$ref": "#/$defs/refArray" },
        "changedPathRefs": { "$ref": "#/$defs/refArray" },
        "commandRefs": { "$ref": "#/$defs/refArray" },
        "evidenceRefs": { "$ref": "#/$defs/refArray" },
        "testRefs": { "$ref": "#/$defs/refArray" },
        "fixtureRefs": { "$ref": "#/$defs/refArray" },
        "assertionRefs": { "$ref": "#/$defs/refArray" },
        "observedSequenceRefs": { "$ref": "#/$defs/refArray" },
        "deterministicReportRefs": { "$ref": "#/$defs/refArray" },
        "proofRefs": { "$ref": "#/$defs/refArray" },
        "unitHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

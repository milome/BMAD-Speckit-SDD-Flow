{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "requirements-contract-record.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "recordId", "lifecycle", "confirmedScopeSemanticHash", "activeAuthority"],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-record/v3" }, "recordId": { "type": "string", "minLength": 1 },
    "lifecycle": { "type": "string", "minLength": 1 },
    "confirmedScopeSemanticHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "activeOperationId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "activeAuthority": { "oneOf": [{ "$ref": "#/$defs/RequirementsActiveAuthorityTupleV3" }, { "type": "null" }] }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "RequirementsActiveAuthorityTupleV3": {
      "title": "RequirementsActiveAuthorityTuple/v3", "type": "object", "additionalProperties": false,
      "required": ["activeSemanticRevisionId", "activeScopeSemanticHash", "activeBindingRevisionId", "activeSourceBindingHash", "activeBuildHash", "activeBuildManifestPath", "previousBuildHash", "previousBuildManifestPath"],
      "properties": {
        "activeSemanticRevisionId": { "$ref": "#/$defs/id" }, "activeScopeSemanticHash": { "$ref": "#/$defs/hash" },
        "activeBindingRevisionId": { "$ref": "#/$defs/id" }, "activeSourceBindingHash": { "$ref": "#/$defs/hash" },
        "activeBuildHash": { "$ref": "#/$defs/hash" }, "activeBuildManifestPath": { "type": "string", "pattern": "^authoring/builds/[a-f0-9]{64}/manifest\\.json$" },
        "previousBuildHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "previousBuildManifestPath": { "oneOf": [{ "type": "string", "pattern": "^authoring/builds/[a-f0-9]{64}/manifest\\.json$" }, { "type": "null" }] }
      }
    }
  }
}

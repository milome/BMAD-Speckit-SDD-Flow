{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-content-ref.schema.json",
  "title": "Requirements Content Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentHash",
    "byteLength",
    "mediaType",
    "recordRelativePath"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-content-ref/v1" },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "recordRelativePath": {
      "type": "string",
      "pattern": "^authoring/objects/sha256/[a-f0-9]{2}/[a-f0-9]{62}$"
    }
  }
}

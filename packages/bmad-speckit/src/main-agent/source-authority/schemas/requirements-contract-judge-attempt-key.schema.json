{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-judge-attempt-key.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "actorClass",
    "judgeRole",
    "sourceAuthorityHash",
    "scopeManifestHash",
    "promptTemplateHash",
    "assessmentSchemaHash",
    "providerRegistryHash",
    "providerConfigurationHash",
    "ledgerNamespace",
    "previousAttemptKeyHash",
    "attemptOrdinal",
    "attemptKeyHash"
  ],
  "properties": {
    "schemaVersion": { "const": "requirements-contract-judge-attempt-key/v1" },
    "attemptId": { "type": "string", "minLength": 1 },
    "actorClass": {
      "enum": ["requirements_critical_auditor_judge", "final_acceptance_judge"]
    },
    "judgeRole": {
      "enum": ["requirements_critical_auditor", "final_acceptance_judge"]
    },
    "sourceAuthorityHash": { "$ref": "#/$defs/hash" },
    "scopeManifestHash": { "$ref": "#/$defs/hash" },
    "promptTemplateHash": { "$ref": "#/$defs/hash" },
    "assessmentSchemaHash": { "$ref": "#/$defs/hash" },
    "providerRegistryHash": { "$ref": "#/$defs/hash" },
    "providerConfigurationHash": { "$ref": "#/$defs/hash" },
    "ledgerNamespace": { "enum": ["requirements", "final_acceptance"] },
    "previousAttemptKeyHash": {
      "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "attemptOrdinal": { "type": "integer", "minimum": 1 },
    "attemptKeyHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actorClass": { "const": "requirements_critical_auditor_judge" }
        }
      },
      "then": {
        "properties": {
          "judgeRole": { "const": "requirements_critical_auditor" },
          "ledgerNamespace": { "const": "requirements" }
        }
      }
    },
    {
      "if": {
        "properties": { "actorClass": { "const": "final_acceptance_judge" } }
      },
      "then": {
        "properties": {
          "judgeRole": { "const": "final_acceptance_judge" },
          "ledgerNamespace": { "const": "final_acceptance" }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

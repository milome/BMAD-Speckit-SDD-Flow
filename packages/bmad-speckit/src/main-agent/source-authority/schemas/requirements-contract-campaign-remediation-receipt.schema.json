{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements-contract-campaign-remediation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "candidateId",
    "verificationDagHash",
    "finalizationByteManifestHash",
    "closedOriginCount",
    "mandatoryCommandExecutionCount",
    "postSealMutationDetected",
    "decision",
    "campaignRemediationReceiptHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "requirements-contract-campaign-remediation-receipt/v1"
    },
    "campaignId": {
      "type": "string",
      "minLength": 1
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "verificationDagHash": { "$ref": "#/$defs/sha256" },
    "finalizationByteManifestHash": { "$ref": "#/$defs/sha256" },
    "closedOriginCount": {
      "type": "integer",
      "minimum": 1
    },
    "mandatoryCommandExecutionCount": {
      "type": "integer",
      "minimum": 1
    },
    "postSealMutationDetected": {
      "const": false
    },
    "decision": {
      "const": "pass"
    },
    "campaignRemediationReceiptHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

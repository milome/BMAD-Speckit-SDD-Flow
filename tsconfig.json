{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "packages/scoring/**/*.ts",
    "scripts/**/*.d.cts",
    "tests/typecheck/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/scoring/**/__tests__/**",
    "packages/scoring/**/*.test.ts",
    "packages/scoring/**/*.spec.ts"
  ]
}

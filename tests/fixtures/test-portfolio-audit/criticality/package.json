{
  "name": "test-portfolio-criticality-fixture",
  "version": "1.0.0",
  "main": "./dist/runtime.cjs",
  "bin": {
    "test-portfolio-fixture": "./bin/test-portfolio-fixture.cjs"
  },
  "scripts": {
    "critical:install": "vitest run tests/package-install.test.ts tests/cli-bin.test.ts",
    "critical:runtime": "vitest run tests/packaged-runtime.test.ts"
  },
  "testPortfolioAudit": {
    "criticalBindings": [
      {
        "bindingId": "consumer-install-boundary",
        "kinds": [
          "package_install",
          "cli_bin",
          "consumer_compatibility"
        ],
        "scriptName": "critical:install"
      },
      {
        "bindingId": "packaged-runtime-boundary",
        "kinds": [
          "packaged_runtime"
        ],
        "scriptName": "critical:runtime"
      }
    ]
  }
}
